# NPM Configuration for Settler Monorepo
# Ensures consistent dependency resolution across all packages

# Use the latest package-lock format
package-lock=true

# Prefer exact versions for workspace dependencies
save-exact=false

# Install optional dependencies to ensure platform binaries (e.g., turbo/esbuild)
optional=true

# Use npm's legacy peer deps handling for better compatibility
legacy-peer-deps=false

# Disable audit for security (dev dependencies only)
audit=false

# Set engine-strict to warn but not fail on engine mismatches
engine-strict=false

# Skip Sentry CLI auto-installation during npm ci (prevents timeout issues)
# This is set via environment variable in preinstall script
# SENTRY_SKIP_AUTO_INSTALL=1

# Ignore audit for dev dependencies
ignore-scripts=false
progress=false
