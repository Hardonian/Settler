# NPM Configuration for Settler Monorepo
# Ensures consistent dependency resolution across all packages

# Use pnpm 10.13.1 (required for Vercel builds)
package-manager=pnpm@10.13.1

# Use pnpm lockfile (pnpm is the source of truth)
lockfile=true
package-lock=false
prefer-frozen-lockfile=true

# Prefer exact versions for workspace dependencies
save-exact=false

# Install optional dependencies to ensure platform binaries (e.g., turbo/esbuild)
optional=true

# Keep native optional binaries available for both local WSL verification and
# Windows/macOS contributor installs. Without this, pnpm can prune the lockfile
# to one platform and make Next/Jest security verification depend on runtime
# SWC downloads.
supportedArchitectures.os[]=current
supportedArchitectures.os[]=linux
supportedArchitectures.os[]=win32
supportedArchitectures.os[]=darwin
supportedArchitectures.cpu[]=current
supportedArchitectures.cpu[]=x64
supportedArchitectures.cpu[]=arm64
supportedArchitectures.libc[]=current
supportedArchitectures.libc[]=glibc
supportedArchitectures.libc[]=musl

# Use npm's legacy peer deps handling for better compatibility
legacy-peer-deps=false

# Disable audit for security (dev dependencies only)
audit=false

# Engine version enforcement.
# CI and Vercel enforce Node 24 via .nvmrc (setup-node) and vercel.json nodeVersion.
# engine-strict is disabled here so that pnpm install warns rather than hard-fails
# for local contributors or evaluators running Node 22. Run `pnpm check:node` to
# explicitly verify the active Node version against the repo contract.
engine-strict=false

# Use the public npm registry for all packages
registry=https://registry.npmjs.org/
# Avoid scoped registry leakage for DefinitelyTyped packages
@types:registry=https://registry.npmjs.org/
# Default to public unauthenticated fetch unless a scoped registry overrides this
always-auth=false

# Skip Sentry CLI auto-installation during npm ci (prevents timeout issues)
# This is set via environment variable in preinstall script
# SENTRY_SKIP_AUTO_INSTALL=1

# Ignore audit for dev dependencies
ignore-scripts=false
progress=false
