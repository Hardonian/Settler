# NPM Configuration for Settler Monorepo
# Ensures consistent dependency resolution across all packages

# Use pnpm 10.13.1 (required for Vercel builds)
package-manager=pnpm@10.13.1

# Use pnpm lockfile (pnpm is the source of truth)
lockfile=true
package-lock=false
prefer-frozen-lockfile=true

# Prefer exact versions for workspace dependencies
save-exact=false

# Install optional dependencies to ensure platform binaries (e.g., turbo/esbuild)
optional=true

# Use npm's legacy peer deps handling for better compatibility
legacy-peer-deps=false

# Disable audit for security (dev dependencies only)
audit=false

# Enforce engine versions for deterministic builds
engine-strict=true

# Use the public npm registry for all packages
registry=https://registry.npmjs.org/
# Avoid scoped registry leakage for DefinitelyTyped packages
@types:registry=https://registry.npmjs.org/
# Default to public unauthenticated fetch unless a scoped registry overrides this
always-auth=false

# Skip Sentry CLI auto-installation during npm ci (prevents timeout issues)
# This is set via environment variable in preinstall script
# SENTRY_SKIP_AUTO_INSTALL=1

# Ignore audit for dev dependencies
ignore-scripts=false
progress=false
