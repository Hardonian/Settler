# Core local defaults for bootstrap/doctor/demo
NODE_ENV=development
DEPLOYMENT_ENV=local
PORT=3000
HOST=0.0.0.0

# Core safety keys (replace before non-local use)
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long-required
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/settler

# Demo-friendly defaults
LOG_LEVEL=info
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Optional integrations (leave blank for first run)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-dev-anon-key

# Optional integrations (uncomment only when used)
# NEXT_PUBLIC_SENTRY_DSN=
# REDIS_URL=rediss://default:password@host:6379
# RESEND_API_KEY=re_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
