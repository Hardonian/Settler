# Core local defaults for bootstrap/doctor/demo
NODE_ENV=development
DEPLOYMENT_ENV=local
PORT=3000
HOST=0.0.0.0

# Core safety keys (replace before non-local use)
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long-required
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=dev-encryption-key-32-chars-long!!

# Demo-friendly defaults
LOG_LEVEL=info
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Optional integrations (leave blank for first run)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
