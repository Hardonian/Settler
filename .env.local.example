# =============================================================================
# Settler Local Development Environment Template
# =============================================================================
# This file provides working defaults for local development.
#
# REQUIRED (must be set for app to start):
#   - JWT_SECRET (min 32 chars)
#   - ENCRYPTION_KEY (exactly 32 chars)
#   - DATABASE_URL (or Supabase alternative)
#
# REQUIRED FOR BROWSER (doctor checks):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - SUPABASE_URL
#   - SUPABASE_ANON_KEY
#
# OPTIONAL (can use dev defaults):
#   - REDIS_URL, RESEND_API_KEY, Stripe keys, etc.
#
# Copy to .env.local: cp .env.local.example .env.local
# =============================================================================

# Core local defaults for bootstrap/doctor/demo
NODE_ENV=development
DEPLOYMENT_ENV=local
PORT=3000
HOST=0.0.0.0

# =============================================================================
# REQUIRED - Security Keys
# =============================================================================
# JWT_SECRET: Minimum 32 characters
# ENCRYPTION_KEY: Exactly 32 characters (hex format)
# DB_PASSWORD: Database password
# DATABASE_URL: PostgreSQL connection string
# =============================================================================
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long-required
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/settler

# Demo-friendly defaults
LOG_LEVEL=info
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Optional: enable local-only preview mode for strategic /api/v2 initiative surfaces.
# Leave disabled by default unless you are explicitly testing preview-only flows.
SETTLER_ENABLE_V2_STRATEGIC_PREVIEW=false

# =============================================================================
# REQUIRED FOR BROWSER - Supabase Configuration
# =============================================================================
# These are checked by pnpm doctor and required for the UI to work
# =============================================================================
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-dev-anon-key

# =============================================================================
# OPTIONAL - Third-party integrations
# =============================================================================
# Uncomment and configure as needed
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=
# REDIS_URL=rediss://default:password@host:6379
# RESEND_API_KEY=re_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# TypeSafe AI Jev (exception triage and review priority only)
JEV_MODE=off
# TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
JEV_TIMEOUT_MS=3000
JEV_MAX_RETRIES=1
JEV_BATCH_SIZE=10
JEV_MIN_CONFIDENCE=0.82
JEV_CIRCUIT_FAILURE_THRESHOLD=3
JEV_CIRCUIT_RESET_MS=60000
JEV_TENANT_ALLOWLIST=

# =============================================================================
# OPTIONAL - Alert notifier channels
# =============================================================================
# SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_ALERT_WEBHOOK_URL=https://outlook.office.com/webhook/...
# TELEGRAM_BOT_TOKEN=123456:ABCDEF
# TELEGRAM_CHAT_ID=-123456789
# ALERT_NOTIFIER_DRY_RUN=true
