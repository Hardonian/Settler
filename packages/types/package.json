{
  "name": "@settler/types",
  "version": "1.0.0",
  "description": "Settler Types - Shared canonical data model types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./support-intake-contract": {
      "types": "./dist/support-intake-contract.d.ts",
      "default": "./dist/support-intake-contract.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs'); fs.existsSync('dist') && fs.rmSync('dist', {recursive: true, force: true})\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@types/node": "^26.4.0",
    "ai": "^7.0.85",
    "typescript": "^6.0.3",
    "zod": "^3.25.76"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
