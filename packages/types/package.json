{
  "name": "@settler/types",
  "version": "1.0.0",
  "description": "Settler Types - Shared canonical data model types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./support-intake-contract": {
      "types": "./dist/support-intake-contract.d.ts",
      "default": "./dist/support-intake-contract.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs'); fs.existsSync('dist') && fs.rmSync('dist', {recursive: true, force: true})\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.27",
    "@types/node": "^26.1.2",
    "ai": "^7.0.77",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
