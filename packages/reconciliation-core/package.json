{
  "name": "@settler/reconciliation-core",
  "version": "1.0.0",
  "description": "Shared canonical reconciliation mapping, merge pagination, and run resolution",
  "license": "PROPRIETARY",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "cd ../.. && node scripts/assert-node-version.mjs",
    "pretest": "cd ../.. && node scripts/assert-node-version.mjs",
    "pretypecheck": "cd ../.. && node scripts/assert-node-version.mjs",
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@prisma/client": "7.10.0",
    "@settler/types": "workspace:*",
    "ai": "^7.0.85",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
