{
  "name": "@settler/reconciliation-core",
  "version": "1.0.0",
  "description": "Shared canonical reconciliation mapping, merge pagination, and run resolution",
  "license": "PROPRIETARY",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "cd ../.. && node scripts/assert-node-version.mjs",
    "pretest": "cd ../.. && node scripts/assert-node-version.mjs",
    "pretypecheck": "cd ../.. && node scripts/assert-node-version.mjs",
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@settler/types": "workspace:*",
    "@prisma/client": "7.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
