    "ioredis-mock": "^8.13.1",
    "jest": "^30.4.2",
    "k6": "^0.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
