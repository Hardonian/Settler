{
  "name": "@settler/api",
  "version": "1.0.0",
  "description": "Settler API Server - Serverless reconciliation service with enterprise-grade operations tooling",
  "author": "Settler.dev",
  "license": "PROPRIETARY",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/email-lifecycle": {
      "import": {
        "types": "./dist/lib/email-lifecycle.d.ts",
        "default": "./dist/lib/email-lifecycle.js"
      },
      "require": {
        "types": "./dist/lib/email-lifecycle.d.ts",
        "default": "./dist/lib/email-lifecycle.js"
      },
      "types": "./dist/lib/email-lifecycle.d.ts",
      "default": "./dist/lib/email-lifecycle.js"
    },
    "./utils/type-guards": {
      "import": {
        "types": "./dist/utils/type-guards.d.ts",
        "default": "./dist/utils/type-guards.js"
      },
      "require": {
        "types": "./dist/utils/type-guards.d.ts",
        "default": "./dist/utils/type-guards.js"
      },
      "types": "./dist/utils/type-guards.d.ts",
      "default": "./dist/utils/type-guards.js"
    },
    "./dist/ops/activation-funnel": {
      "import": {
        "types": "./dist/ops/activation-funnel.d.ts",
        "default": "./dist/ops/activation-funnel.js"
      },
      "require": {
        "types": "./dist/ops/activation-funnel.d.ts",
        "default": "./dist/ops/activation-funnel.js"
      },
      "types": "./dist/ops/activation-funnel.d.ts",
      "default": "./dist/ops/activation-funnel.js"
    },
    "./dist/ops/billing-hardening": {
      "import": {
        "types": "./dist/ops/billing-hardening.d.ts",
        "default": "./dist/ops/billing-hardening.js"
      },
      "require": {
        "types": "./dist/ops/billing-hardening.d.ts",
        "default": "./dist/ops/billing-hardening.js"
      },
      "types": "./dist/ops/billing-hardening.d.ts",
      "default": "./dist/ops/billing-hardening.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "pretest": "cd ../.. && node scripts/assert-node-version.mjs && pnpm --filter @settler/types run build && pnpm --filter @settler/adapters run build && pnpm --filter @settler/support-intake run build && pnpm --filter @settler/reconciliation-core run build",
    "prebuild": "cd ../.. && node scripts/assert-node-version.mjs && pnpm run prisma:generate && pnpm --filter @settler/types run build && pnpm --filter @settler/adapters run build && pnpm --filter @settler/support-intake run build && pnpm --filter @settler/reconciliation-core run build",
    "pretypecheck": "cd ../.. && node scripts/assert-node-version.mjs && pnpm --filter @settler/types run build && pnpm --filter @settler/adapters run build && pnpm --filter @settler/support-intake run build && pnpm --filter @settler/reconciliation-core run build",
    "build": "node ../../scripts/run-package-tsc-build.mjs --skipLibCheck --noEmit false",
    "dev": "tsx watch src/index.ts",
    "start": "node ../../scripts/assert-node-version.mjs && node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate:check": "tsx src/db/migrate.ts --check",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:operator-mode": "jest src/__tests__/operator-mode-verification.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "operator-mode:daily": "tsx src/jobs/operator-mode-daily.ts",
    "worker:export": "tsx src/jobs/worker/index.ts",
    "worker:export:dev": "tsx watch src/jobs/worker/index.ts",
    "worker:queue": "tsx src/jobs/queue/index.ts",
    "worker:prune": "tsx src/jobs/prune-old-data.ts",
    "test:tenant-safety": "jest src/__tests__/application/job-service-invocation-order.test.ts src/__tests__/application/user-service-invocation-order.test.ts src/__tests__/application/webhook-ingestion-invocation-order.test.ts src/__tests__/repositories/job-repository-tenant-contract.test.ts src/__tests__/repositories/user-repository-tenant-contract.test.ts src/__tests__/repositories/tenant-repository-tenant-contract.test.ts src/__tests__/eventsourcing/event-store-tenant-contract.test.ts",
    "test:resilience": "jest src/__tests__/resilience/api-resilience.test.ts --runInBand --forceExit",
    "test:recon-merged-db": "jest src/__tests__/integration/reconciliation-merged-list.db.test.ts --runInBand --forceExit",
    "test:tb": "jest src/__tests__/integration/tigerbeetle.test.ts --runInBand --forceExit",
    "tb:start": "docker-compose up -d tigerbeetle",
    "tb:stop": "docker-compose stop tigerbeetle",
    "tb:logs": "docker-compose logs -f tigerbeetle",
    "tb:reset": "docker-compose down -v && docker-compose up -d tigerbeetle",
    "tb:status": "docker-compose ps tigerbeetle && docker-compose exec -T tigerbeetle nc -z localhost 4300 && echo 'TigerBeetle is healthy' || echo 'TigerBeetle is not responding'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.27",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "7.9.0",
    "@sentry/node": "^10.68.0",
    "@sentry/profiling-node": "^10.69.0",
    "@settler/adapters": "workspace:*",
    "@settler/edge-ai-core": "workspace:*",
    "@settler/proofs": "workspace:*",
    "@settler/reconciliation-core": "workspace:*",
    "@settler/sdk": "workspace:*",
    "@settler/support-intake": "workspace:*",
    "@settler/types": "workspace:*",
    "@supabase/supabase-js": "^2.106.1",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.76",
    "ajv": "^8.20.0",
