{
  "name": "@settler/api",
  "version": "1.0.0",
  "description": "Settler API Server - Serverless reconciliation service with enterprise-grade operations tooling",
  "author": "Settler.dev",
  "license": "PROPRIETARY",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/email-lifecycle": {
      "types": "./dist/lib/email-lifecycle.d.ts",
      "default": "./dist/lib/email-lifecycle.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "cd ../.. && npm run prisma:generate || npx prisma generate || echo 'Warning: Prisma generate may have failed'",
    "build": "npm run typecheck && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate:check": "tsx src/db/migrate.ts --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:operator-mode": "jest src/__tests__/operator-mode-verification.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "operator-mode:daily": "tsx src/jobs/operator-mode-daily.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^7.91.0",
    "@sentry/profiling-node": "^7.91.0",
    "@settler/adapters": "*",
    "@settler/edge-ai-core": "*",
    "@settler/sdk": "*",
    "@settler/types": "*",
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/redis": "^1.25.0",
    "async-mutex": "^0.4.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.3.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "envalid": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "isomorphic-dompurify": "^2.9.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "opossum": "^9.0.0",
    "p-retry": "^6.2.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.3.0",
    "resend": "^3.2.0",
    "socket.io": "^4.7.2",
    "stripe": "^14.25.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.13.3",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "artillery": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "k6": "^0.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
