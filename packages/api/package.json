    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ip-cidr": "^4.0.2",
    "isomorphic-dompurify": "^3.22.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "opossum": "^10.0.0",
    "p-retry": "^6.2.1",
    "passport": "^0.7.0",
    "@node-saml/passport-saml": "^5.1.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.18.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "swagger-ui-express": "^5.0.1",
    "tigerbeetle-node": "0.17.9",
    "uuid": "^13.0.2",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
