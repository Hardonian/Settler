{
  "name": "@settler/api",
  "version": "1.0.0",
  "description": "Settler API Server - Serverless reconciliation service with enterprise-grade operations tooling",
  "author": "Settler.dev",
  "license": "PROPRIETARY",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/email-lifecycle": {
      "import": {
        "types": "./dist/lib/email-lifecycle.d.ts",
        "default": "./dist/lib/email-lifecycle.js"
      },
      "require": {
        "types": "./dist/lib/email-lifecycle.d.ts",
        "default": "./dist/lib/email-lifecycle.js"
      },
      "types": "./dist/lib/email-lifecycle.d.ts",
      "default": "./dist/lib/email-lifecycle.js"
    },
    "./utils/type-guards": {
      "import": {
        "types": "./dist/utils/type-guards.d.ts",
        "default": "./dist/utils/type-guards.js"
      },
      "require": {
        "types": "./dist/utils/type-guards.d.ts",
        "default": "./dist/utils/type-guards.js"
      },
      "types": "./dist/utils/type-guards.d.ts",
      "default": "./dist/utils/type-guards.js"
    },
    "./dist/ops/activation-funnel": {
      "import": {
        "types": "./dist/ops/activation-funnel.d.ts",
        "default": "./dist/ops/activation-funnel.js"
      },
      "require": {
        "types": "./dist/ops/activation-funnel.d.ts",
        "default": "./dist/ops/activation-funnel.js"
      },
      "types": "./dist/ops/activation-funnel.d.ts",
      "default": "./dist/ops/activation-funnel.js"
    },
    "./dist/ops/billing-hardening": {
      "import": {
        "types": "./dist/ops/billing-hardening.d.ts",
        "default": "./dist/ops/billing-hardening.js"
      },
      "require": {
        "types": "./dist/ops/billing-hardening.d.ts",
        "default": "./dist/ops/billing-hardening.js"
      },
      "types": "./dist/ops/billing-hardening.d.ts",
      "default": "./dist/ops/billing-hardening.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "cd ../.. && pnpm run prisma:generate || pnpm exec prisma generate || echo 'Warning: Prisma generate may have failed'",
    "pretypecheck": "cd ../.. && pnpm run prisma:generate || pnpm exec prisma generate || echo 'Warning: Prisma generate may have failed'",
    "build": "tsc --skipLibCheck --noEmit false",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate:check": "tsx src/db/migrate.ts --check",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:operator-mode": "jest src/__tests__/operator-mode-verification.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "operator-mode:daily": "tsx src/jobs/operator-mode-daily.ts",
    "test:tenant-safety": "jest src/__tests__/application/job-service-invocation-order.test.ts src/__tests__/application/user-service-invocation-order.test.ts src/__tests__/application/webhook-ingestion-invocation-order.test.ts src/__tests__/repositories/job-repository-tenant-contract.test.ts src/__tests__/repositories/user-repository-tenant-contract.test.ts src/__tests__/repositories/tenant-repository-tenant-contract.test.ts src/__tests__/eventsourcing/event-store-tenant-contract.test.ts",
    "test:resilience": "jest src/__tests__/resilience/api-resilience.test.ts --runInBand --forceExit",
    "test:tb": "jest src/__tests__/integration/tigerbeetle.test.ts --runInBand --forceExit",
    "tb:start": "docker-compose up -d tigerbeetle",
    "tb:stop": "docker-compose stop tigerbeetle",
    "tb:logs": "docker-compose logs -f tigerbeetle",
    "tb:reset": "docker-compose down -v && docker-compose up -d tigerbeetle",
    "tb:status": "docker-compose ps tigerbeetle && docker-compose exec -T tigerbeetle nc -z localhost 4300 && echo 'TigerBeetle is healthy' || echo 'TigerBeetle is not responding'"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^7.91.0",
    "@sentry/profiling-node": "^7.91.0",
    "@settler/adapters": "workspace:*",
    "@settler/edge-ai-core": "workspace:*",
    "@settler/sdk": "workspace:*",
    "@settler/types": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/redis": "^1.25.0",
    "async-mutex": "^0.4.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.3.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "envalid": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "isomorphic-dompurify": "^2.9.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "opossum": "^9.0.0",
    "p-retry": "^6.2.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.3.0",
    "resend": "^3.2.0",
    "socket.io": "^4.7.2",
    "stripe": "^14.25.0",
    "tigerbeetle-node": "0.16.77",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.3",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "artillery": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "k6": "^0.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
