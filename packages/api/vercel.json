{
  "version": 2,
  "buildCommand": "cd ../.. && npm ci && npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
