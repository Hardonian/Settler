{
  "version": 2,
  "installCommand": "corepack enable && corepack prepare pnpm@10.13.1 --activate && cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @settler/api build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
