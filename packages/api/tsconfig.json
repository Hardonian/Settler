{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "paths": {
      "@settler/adapters": ["../adapters/dist/index"],
      "@settler/adapters/*": ["../adapters/dist/*"]
    },
    "types": ["node", "jest"],
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__",
    "src/services/ai-agents",
    "src/services/predictive",
    "src/services/economic",
    "src/services/futureproof",
    "src/services/pricing",
    "src/routes/v2/ai-agents.ts"
  ]
}
