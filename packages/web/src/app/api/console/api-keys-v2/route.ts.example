/**
 * Console API Keys Route (V2 - Using New Infrastructure)
 * 
 * Example migration showing how to use the new standardized handler.
 * This replaces the old pattern with better type safety, validation, and error handling.
 */

import { createConsoleMutationHandler, createConsoleGetHandler } from '@/lib/api/console-handler';
import { createApiKeySchema, listApiKeysSchema } from '@/lib/api/console-schemas';
import { listApiKeys, createApiKey } from '@/domain/console/apiKeys';
import { redisRateLimiters } from '@/lib/security/rate-limiter-redis';

/**
 * GET /api/console/api-keys-v2
 * List API keys with pagination
 */
export const GET = createConsoleGetHandler(
  async (context) => {
    const { auth, request } = context;
    
    // Parse query params (could also use schema validation)
    const { searchParams } = new URL(request.url);
    const limit = parseInt(searchParams.get('limit') || '50', 10);
    const offset = parseInt(searchParams.get('offset') || '0', 10);

    // Use domain function (already has error handling)
    const keys = await listApiKeys(auth.userId);

    // Apply pagination
    const paginatedKeys = keys.slice(offset, offset + limit);

    return {
      keys: paginatedKeys,
      pagination: {
        total: keys.length,
        limit,
        offset,
        hasMore: offset + limit < keys.length,
      },
    };
  },
  {
    rateLimiter: redisRateLimiters.api,
  }
);

/**
 * POST /api/console/api-keys-v2
 * Create new API key
 */
export const POST = createConsoleMutationHandler(
  async (context, input) => {
    const { auth } = context;

    // Input is already validated by schema
    const result = await createApiKey(auth.userId, {
      name: input.name,
      scopes: input.scopes,
      expiresAt: input.expiresAt ? new Date(input.expiresAt) : undefined,
    });

    return result;
  },
  createApiKeySchema,
  {
    rateLimiter: redisRateLimiters.api,
    requiredScopes: ['api_keys:write'], // For API key auth
  }
);
