# ============================================================================
# Settler Web - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# For Vercel deployment, add these to your project settings

# ============================================================================
# Site Configuration
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://settler.dev

# ============================================================================
# Supabase Configuration (Required)
# ============================================================================
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (for API routes and server actions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# Database Configuration (Optional - for Prisma)
# ============================================================================
# Direct PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
POSTGRES_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
POSTGRES_PRISMA_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
POSTGRES_PASSWORD=your-database-password

# ============================================================================
# Analytics Configuration
# ============================================================================
# Comma-separated list: vercel,ga4,posthog,custom,none
NEXT_PUBLIC_ANALYTICS_PROVIDERS=vercel

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Custom Analytics Endpoint
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_TOKEN=

# ============================================================================
# Error Reporting (Sentry)
# ============================================================================
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_VERCEL_LOG_DRAIN_URL=
SENTRY_OTLP_TRACES_URL=
SENTRY_PUBLIC_KEY=

# ============================================================================
# Session Replay
# ============================================================================
NEXT_PUBLIC_ENABLE_SESSION_REPLAY=false
NEXT_PUBLIC_SESSION_REPLAY_PROVIDER=none
# Options: hotjar,fullstory,clarity,none
NEXT_PUBLIC_SESSION_REPLAY_SITE_ID=
NEXT_PUBLIC_SESSION_REPLAY_API_KEY=

# ============================================================================
# Logging
# ============================================================================
NEXT_PUBLIC_ENABLE_LOGGING=true
NEXT_PUBLIC_LOG_LEVEL=info
# Options: debug,info,warn,error,critical
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false
NEXT_PUBLIC_LOGGING_ENDPOINT=

# ============================================================================
# Vercel Integrations (Optional)
# ============================================================================
# Vercel KV (Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Edge Config
EDGE_CONFIG=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# ============================================================================
# Redis (Alternative to Vercel KV)
# ============================================================================
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS=

# ============================================================================
# Queue & Background Jobs
# ============================================================================
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ============================================================================
# Email (Resend)
# ============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# ============================================================================
# Security
# ============================================================================
# JWT Secret (must be at least 32 characters)
JWT_SECRET=

# Encryption Key (must be exactly 32 or 64 characters)
ENCRYPTION_KEY=

# ============================================================================
# Development Only
# ============================================================================
# NODE_ENV=development
