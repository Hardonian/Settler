# =============================================================================
# SETTLER ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git (it contains secrets!)
#
# Based on ENV MATRIX from Technical Readiness Discovery Report
# See: /TECHNICAL_READINESS_DISCOVERY_REPORT.md Section 4
# =============================================================================

# -----------------------------------------------------------------------------
# BUILD & DEPLOYMENT
# -----------------------------------------------------------------------------
NODE_ENV=development
# VERCEL_URL=             # Auto-injected by Vercel
# VERCEL_ENV=             # Auto-injected by Vercel (production/preview/development)
# VERCEL_GIT_COMMIT_SHA=  # Auto-injected by Vercel

# -----------------------------------------------------------------------------
# CRITICAL: DATABASE & AUTHENTICATION
# -----------------------------------------------------------------------------
# Required for application to function

# Supabase (Public - safe to expose on client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-min-20-chars

# Supabase (Server-side only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-min-20-chars

# Direct PostgreSQL Connection (Server-side only)
DATABASE_URL=postgresql://postgres:password@localhost:5432/settler?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/settler?schema=public

# Security Secrets (Server-side only)
JWT_SECRET=dev-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=dev-encryption-key-32-chars-!!!

# NextAuth (if using NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# -----------------------------------------------------------------------------
# APPLICATION URLS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://settler.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# BILLING & PAYMENTS (Optional - enables Stripe integration)
# -----------------------------------------------------------------------------
# Leave blank to disable billing features

# Stripe (Server-side only)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe (Client-side)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# EMAIL & NOTIFICATIONS (Optional - enables email features)
# -----------------------------------------------------------------------------
# Leave blank to disable email functionality

# Resend.com
# RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@settler.dev
# RESEND_AUDIENCE_ID=...

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY (Optional - enables error tracking)
# -----------------------------------------------------------------------------
# Leave blank to disable Sentry

# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=settler
# SENTRY_AUTH_TOKEN=...
NEXT_PUBLIC_ENABLE_SENTRY=false

# -----------------------------------------------------------------------------
# CACHING & PERFORMANCE (Optional - falls back to in-memory)
# -----------------------------------------------------------------------------
# Redis (local development)
REDIS_URL=redis://localhost:6379

# Upstash Redis (serverless/production - optional alternative to local Redis)
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# -----------------------------------------------------------------------------
# AI & EXTERNAL SERVICES (Optional - enables specific features)
# -----------------------------------------------------------------------------
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo

# Builder.io (Visual page builder)
# BUILDER_API_KEY=...
# NEXT_PUBLIC_BUILDER_API_KEY=...
# NEXT_PUBLIC_BUILDER_PUBLIC_KEY=...
# BUILDER_WEBHOOK_SECRET=...
# NEXT_PUBLIC_BUILDER_PREVIEW_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# ENABLE_CHATBOT=true
# ENABLE_ANALYTICS=true
# ENABLE_NEWSLETTER=true
# ANALYTICS_ENABLED=true
# ENABLE_IMAGE_OPTIMIZATION=true

# -----------------------------------------------------------------------------
# AUTHENTICATION & API KEYS (Optional)
# -----------------------------------------------------------------------------
# INVESTOR_API_KEY=your-investor-api-key-here

# =============================================================================
# FAILURE MODES & GRACEFUL DEGRADATION
# =============================================================================
#
# CRITICAL (App will crash if missing):
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# - DATABASE_URL
#
# FEATURE-SPECIFIC (Feature disabled if missing):
# - STRIPE_* → Billing routes return 503
# - RESEND_API_KEY → Emails not sent (logged as warnings)
# - SENTRY_DSN → Errors not tracked (silent fallback)
# - REDIS_URL → Falls back to in-memory cache (dev only)
# - OPENAI_API_KEY → AI features disabled
# - BUILDER_API_KEY → Visual builder disabled
#
# =============================================================================

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# ✅ SAFE TO LOG:
# - NODE_ENV, VERCEL_URL, VERCEL_ENV
# - All NEXT_PUBLIC_* variables (client-accessible by design)
#
# ❌ NEVER LOG OR EXPOSE:
# - SUPABASE_SERVICE_ROLE_KEY (bypasses RLS!)
# - DATABASE_URL (contains password)
# - JWT_SECRET (allows token forgery)
# - ENCRYPTION_KEY (decrypt sensitive data)
# - STRIPE_SECRET_KEY (charge cards)
# - STRIPE_WEBHOOK_SECRET (accept fake webhooks)
# - RESEND_API_KEY (send emails from your domain)
# - SENTRY_AUTH_TOKEN (upload source maps)
# - UPSTASH tokens, OPENAI_API_KEY, BUILDER_API_KEY
#
# =============================================================================

# -----------------------------------------------------------------------------
# EXTERNAL PLATFORM STACK (OPTIONAL, TRUTHFUL DEGRADE WHEN UNSET)
# -----------------------------------------------------------------------------
# Supabase Auth / SSO readiness
SUPABASE_AUTH_ENABLED=true
SUPABASE_ENTERPRISE_SSO_ENABLED=false
# SUPABASE_ENTERPRISE_SSO_PROVIDER_ID=sso-provider-id
# SUPABASE_ENTERPRISE_SSO_DOMAIN=acme.com

# OpenFGA authz engine
OPENFGA_ENABLED=false
# OPENFGA_API_URL=http://localhost:8080
# OPENFGA_STORE_ID=01H...
# OPENFGA_MODEL_ID=01H...

# Temporal durable workflows
TEMPORAL_ENABLED=false
TEMPORAL_WORKER_ENABLED=false
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=settler-core

# OpenTelemetry
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=settler-web

# Nango connector auth
NANGO_ENABLED=false
# NANGO_BASE_URL=https://api.nango.dev
# NANGO_SECRET_KEY=nango_secret_key

# Airbyte ingestion / CDC
AIRBYTE_ENABLED=false
# AIRBYTE_BASE_URL=http://localhost:8000
# AIRBYTE_CLIENT_ID=client-id
# AIRBYTE_CLIENT_SECRET=client-secret
# AIRBYTE_API_KEY=api-key
# AIRBYTE_WORKSPACE_ID=workspace-id
