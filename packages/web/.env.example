# ============================================================================
# SETTLER.DEV ENVIRONMENT VARIABLES
# ============================================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://settler.dev
NEXT_PUBLIC_APP_URL=https://settler.dev

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/settler?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/settler?schema=public

# NextAuth
NEXTAUTH_URL=https://settler.dev
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# OpenAI (Chatbot)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# Resend (Email)
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=...
RESEND_FROM_EMAIL=Settler <onboarding@settler.dev>

# Authentication
INVESTOR_API_KEY=your-investor-api-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel
VERCEL_ENV=production
VERCEL_URL=

# Analytics
ANALYTICS_ENABLED=true

# Feature Flags
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=true
ENABLE_NEWSLETTER=true

# Build Configuration
NODE_ENV=production
SKIP_ENV_VALIDATION=false

# Sentry (Optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Image Optimization
ENABLE_IMAGE_OPTIMIZATION=true

# Builder.io (Visual Page Builder)
NEXT_PUBLIC_BUILDER_API_KEY=your-builder-api-key-here
BUILDER_API_KEY=your-builder-api-key-here
BUILDER_WEBHOOK_SECRET=your-webhook-secret-here
NEXT_PUBLIC_BUILDER_PREVIEW_URL=http://localhost:3000
