{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "composite": false,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": ".next/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@settler/api": ["../api/dist"],
      "@settler/api/*": ["../api/dist/*"],
      "@settler/api/lib/*": ["../api/dist/lib/*"],
      "@settler/api/dist/ops/*": ["../api/dist/ops/*"],
      "@settler/adapters": ["../adapters/dist"],
      "@settler/adapters/*": ["../adapters/dist/*"],
      "@settler/react-settler": ["../react-settler/dist"],
      "@settler/react-settler/*": ["../react-settler/dist/*"],
      "@settler/protocol": ["../protocol/dist"],
      "@settler/protocol/*": ["../protocol/dist/*"],
      "@settler/sdk": ["../sdk/src"],
      "@settler/sdk/*": ["../sdk/src/*"],
      "@settler/types": ["../types/dist"],
      "@settler/types/*": ["../types/dist/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "middleware.ts",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "node_modules",
    ".next",
    "dist",
    "out",
    "src/stitch_export/**"
  ]
}
