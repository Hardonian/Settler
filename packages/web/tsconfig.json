{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "composite": false,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": ".next/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@prisma/client": [
        "../../node_modules/.pnpm/@prisma+client@7.6.0_prisma@7.6.0_@types+react-dom@18.3.7_@types+react@18.3.28__@types+_eecaa3bb0a9281ef04726703c9c67e78/node_modules/@prisma/client/index.d.ts"
      ],
      ".prisma/client": [
        "../../node_modules/.pnpm/@prisma+client@7.6.0_prisma@7.6.0_@types+react-dom@18.3.7_@types+react@18.3.28__@types+_eecaa3bb0a9281ef04726703c9c67e78/node_modules/.prisma/client/index.d.ts"
      ],
      "@/*": ["./src/*"],
      "@settler/api": ["../api/dist"],
      "@settler/api/*": ["../api/dist/*"],
      "@settler/api/lib/*": ["../api/dist/lib/*"],
      "@settler/api/dist/ops/*": ["../api/dist/ops/*"],
      "@settler/adapters": ["../adapters/dist"],
      "@settler/adapters/*": ["../adapters/dist/*"],
      "@settler/react-settler": ["../react-settler/dist"],
      "@settler/react-settler/*": ["../react-settler/dist/*"],
      "@settler/protocol": ["../protocol/dist"],
      "@settler/protocol/*": ["../protocol/dist/*"],
      "@settler/sdk": ["../sdk/src"],
      "@settler/sdk/*": ["../sdk/src/*"],
      "@settler/types": ["../types/dist"],
      "@settler/types/*": ["../types/dist/*"],
      "@settler/reconciliation-core": ["../reconciliation-core/dist"],
      "@settler/reconciliation-core/*": ["../reconciliation-core/dist/*"],
      "@settler/support-intake": ["../support-intake/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "middleware.ts",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "node_modules",
    ".next",
    "dist",
    "out",
    "src/stitch_export/**"
  ]
}
