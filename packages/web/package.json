{
  "name": "@settler/web",
  "version": "1.0.0",
  "description": "Settler Web Application - Next.js frontend with Developer Console and Admin Dashboard",
  "author": "Settler.dev",
  "license": "PROPRIETARY",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean:build": "rm -rf .next dist out .next/tsconfig.tsbuildinfo",
    "validate:api-routes": "test -f ../../scripts/validate-api-routes.ts && tsx ../../scripts/validate-api-routes.ts || echo '⚠️  API route validation skipped (script not found)'",
    "build": "next build --webpack",
    "build:vercel": "next build --webpack",
    "postinstall": "export SENTRY_SKIP_AUTO_INSTALL=1 || set SENTRY_SKIP_AUTO_INSTALL=1 || true",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit --skipLibCheck",
    "validate:prebuild": "pnpm run typecheck:ci",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "ANALYZE=true next build && echo '\n📦 Bundle analysis complete. Open the generated HTML report to view details.'",
    "bundle:size": "next build && du -sh .next && du -sh .next/static && du -sh .next/static/chunks",
    "bundle:check": "echo '⚠️  Run \"pnpm build\" first, then \"pnpm bundle:size\" to check bundle sizes'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@builder.io/react": "^9.1.0",
    "@builder.io/sdk": "^6.2.0",
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^14.0.4",
    "@prisma/client": "^7.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@sentry/nextjs": "^7.91.0",
    "@settler/api": "workspace:*",
    "@settler/protocol": "workspace:*",
    "@settler/react-settler": "workspace:*",
    "@settler/sdk": "workspace:*",
    "@settler/types": "workspace:*",
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/bcrypt": "^6.0.0",
    "@upstash/redis": "^1.25.0",
    "@vercel/analytics": "^1.1.1",
    "@vercel/blob": "^0.26.0",
    "@vercel/edge-config": "^1.0.0",
    "@vercel/kv": "^0.2.0",
    "@vercel/speed-insights": "^1.0.2",
    "@xstate/react": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "critters": "^0.0.20",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.15",
    "lucide-react": "^0.555.0",
    "next": "16.1.6",
    "next-mdx-remote": "^5.0.0",
    "openai": "^4.28.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.0",
    "stripe": "^20.0.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "uuid": "^13.0.0",
    "xstate": "^5.25.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.7",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
