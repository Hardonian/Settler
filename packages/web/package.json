{
  "name": "@settler/web",
  "version": "1.0.0",
  "description": "Settler Web Application - Next.js frontend with Developer Console and Admin Dashboard",
  "author": "Settler.dev",
  "license": "PROPRIETARY",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:brand-assets": "node ./scripts/generate-brand-assets.mjs",
    "clean:build": "rm -rf .next dist out .next/tsconfig.tsbuildinfo",
    "validate:api-routes": "test -f ../../scripts/validate-api-routes.ts && tsx ../../scripts/validate-api-routes.ts || echo '⚠️  API route validation skipped (script not found)'",
    "validate:boundary": "tsx ./scripts/check-public-route-boundary.ts",
    "prebuild": "cd ../.. && node scripts/assert-node-version.mjs && pnpm run prisma:generate && pnpm --filter @settler/types run build && pnpm --filter @settler/support-intake run build && pnpm --filter @settler/reconciliation-core run build",
    "build": "node ./scripts/assert-build-env.mjs && node ./scripts/assert-reconciliation-core-dist.mjs && next build --webpack",
    "build:vercel": "node ./scripts/assert-build-env.mjs && node ./scripts/assert-reconciliation-core-dist.mjs && next build --webpack",
    "start": "node ../../scripts/assert-node-version.mjs && next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit --skipLibCheck",
    "validate:prebuild": "pnpm run typecheck:ci",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "ANALYZE=true next build && echo '\n📦 Bundle analysis complete. Open the generated HTML report to view details.'",
    "bundle:size": "next build && du -sh .next && du -sh .next/static && du -sh .next/static/chunks",
    "bundle:check": "echo '⚠️  Run \"pnpm build\" first, then \"pnpm bundle:size\" to check bundle sizes'",
    "test": "node ../../scripts/run-with-env.mjs --set NODE_OPTIONS=--max-old-space-size=8192 -- jest --runInBand",
    "test:connector-webhook-slice": "node ../../scripts/run-with-env.mjs --set NODE_OPTIONS=--max-old-space-size=8192 -- jest --runInBand src/__tests__/server/migration-truth.test.ts src/__tests__/server/resolve-connector-webhook-context.test.ts src/__tests__/api/connectors-webhook-runtime.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "node ../../scripts/run-with-env.mjs --set NODE_OPTIONS=--max-old-space-size=8192 -- jest --coverage --runInBand"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@builder.io/react": "^9.4.0",
    "@builder.io/sdk": "^6.3.0",
    "@jobforge/sdk-ts": "workspace:*",
    "@jobforge/shared": "workspace:*",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.53.1",
    "@settler/api": "workspace:*",
    "@settler/protocol": "workspace:*",
    "@settler/react-settler": "workspace:*",
    "@settler/reconciliation-core": "workspace:*",
    "@settler/sdk": "workspace:*",
    "@settler/support-intake": "workspace:*",
    "@settler/types": "workspace:*",
    "@stripe/stripe-js": "^8.11.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@types/bcrypt": "^6.0.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^0.26.0",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/speed-insights": "^1.3.1",
    "@xstate/react": "^6.1.0",
    "ai": "^6.0.199",
    "autoprefixer": "^10.5.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.23",
    "lucide-react": "^1.18.0",
    "next": "^16.2.6",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^1.4.41",
    "stripe": "^20.4.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "uuid": "^13.0.2",
    "xstate": "^5.31.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  }
}
