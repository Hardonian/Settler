{
  "name": "@settler/edge-node",
  "version": "1.0.0",
  "description": "Settler Edge Node - Local reconciliation engine with AI capabilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "settler-edge": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "pnpm run typecheck",
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@settler/types": "workspace:*",
    "ai": "^7.0.85",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^6.0.0",
    "commander": "^11.1.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "uuid": "^13.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "settler",
    "edge",
    "ai",
    "reconciliation",
    "local-processing"
  ],
  "license": "MIT"
}
