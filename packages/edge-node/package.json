{
  "name": "@settler/edge-node",
  "version": "1.0.0",
  "description": "Settler Edge Node - Local reconciliation engine with AI capabilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "settler-edge": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "pnpm run typecheck",
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@settler/types": "workspace:*",
    "ai": "^6.0.199",
    "axios": "^1.18.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "dotenv": "^17.4.2",
    "node-cron": "^3.0.3",
    "uuid": "^13.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.4",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "settler",
    "edge",
    "ai",
    "reconciliation",
    "local-processing"
  ],
  "license": "MIT"
}
