{
  "name": "@settler/sdk",
  "version": "1.0.0",
  "description": "Production-grade TypeScript SDK for the Settler Reconciliation API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./clients/*": {
      "import": "./dist/clients/*.js",
      "require": "./dist/clients/*.js",
      "types": "./dist/clients/*.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "require": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "prebuild": "cd ../.. && node scripts/assert-node-version.mjs",
    "pretest": "cd ../.. && node scripts/assert-node-version.mjs",
    "pretypecheck": "cd ../.. && node scripts/assert-node-version.mjs",
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@types/node": "^26.4.0",
    "ai": "^7.0.85",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@types/jest": "^30.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "reconciliation",
    "api",
    "sdk",
    "typescript",
    "payments",
    "ecommerce",
    "settler",
    "webhook",
    "reconciliation-as-a-service"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/settler/settler.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
