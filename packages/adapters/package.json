{
  "name": "@settler/adapters",
  "version": "1.0.0",
  "description": "Settler Adapters - Platform adapters for reconciliation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "default": "./dist/drivers/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsc --watch",
    "test": "jest --config jest.config.cjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.46",
    "@settler/types": "workspace:*",
    "@supabase/supabase-js": "^2.106.1",
    "ai": "^7.0.77",
    "resend": "^6.18.1",
    "stripe": "^22.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
