{
  "name": "@settler/adapters",
  "version": "1.0.0",
  "description": "Settler Adapters - Platform adapters for reconciliation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "default": "./dist/drivers/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsc --watch",
    "test": "jest --config jest.config.cjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@settler/types": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "zod": "^3.22.4",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "typescript": "^5.3.3",
    "ts-jest": "^29.4.9",
    "@types/jest": "^29.5.14"
  },
  "license": "MIT"
}
