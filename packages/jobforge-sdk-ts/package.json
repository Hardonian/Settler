{
  "name": "@jobforge/sdk-ts",
  "version": "1.7.0",
  "private": true,
  "description": "TypeScript SDK for JobForge (server-only)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@jobforge/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "ai": "^7.0.137",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@jobforge/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  }
}
