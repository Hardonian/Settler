{
  "name": "@settler/protocol",
  "version": "0.1.0",
  "description": "Framework-agnostic protocol types for reconciliation workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "PROTOCOL.md"
  ],
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "test": "jest",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.73",
    "@types/node": "^24.12.4",
    "ai": "^6.0.208",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "reconciliation",
    "payments",
    "settlement",
    "protocol",
    "types"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/settler/react-settler.git",
    "directory": "packages/protocol"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
