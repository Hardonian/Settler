{
  "name": "@settler/cli",
  "version": "1.0.0",
  "description": "Settler CLI - Command-line tool for reconciliation operations",
  "bin": {
    "settler": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jobforge/sdk-ts": "workspace:*",
    "@settler/sdk": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "dotenv": "^16.3.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "reconciliation",
    "cli",
    "command-line",
    "payments",
    "ecommerce"
  ],
  "license": "MIT"
}
