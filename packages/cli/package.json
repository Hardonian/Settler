{
  "name": "@settler/cli",
  "version": "1.0.0",
  "description": "Settler CLI - Command-line tool for reconciliation operations",
  "bin": {
    "settler": "./dist/index.js",
    "requiem": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "perf:hot-path": "node scripts/perf-hot-path.mjs",
    "mcp:smoke": "tsx src/index.ts mcp ping",
    "test:mcp-smoke": "node --test tests/mcp-smoke.test.mjs",
    "foundry:core": "tsx src/index.ts foundry vectors run --suite core --seeds 1,2",
    "foundry:metamorphic": "tsx src/index.ts foundry metamorphic generate --base-suite core --per 1 --seed 1",
    "foundry:faults": "tsx src/index.ts foundry generate --type faults --seeds 1 && node ../../scripts/run-with-env.mjs --set FOUNDRY_FAULTS=1 -- tsx src/index.ts foundry report --last 1"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@jobforge/sdk-ts": "workspace:*",
    "@settler/sdk": "workspace:*",
    "ai": "^6.0.199",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "dotenv": "^17.4.2",
    "inquirer": "^8.2.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.8",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "reconciliation",
    "cli",
    "command-line",
    "payments",
    "ecommerce"
  ],
  "license": "MIT"
}
