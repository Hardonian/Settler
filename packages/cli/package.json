{
  "name": "@settler/cli",
  "version": "1.0.0",
  "description": "Settler CLI - Command-line tool for reconciliation operations",
  "bin": {
    "settler": "./dist/index.js",
    "requiem": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "perf:hot-path": "node scripts/perf-hot-path.mjs",
    "mcp:smoke": "tsx src/index.ts mcp ping",
    "test:mcp-smoke": "node --test tests/mcp-smoke.test.mjs",
    "foundry:core": "tsx src/index.ts foundry vectors run --suite core --seeds 1,2",
    "foundry:metamorphic": "tsx src/index.ts foundry metamorphic generate --base-suite core --per 1 --seed 1",
    "foundry:faults": "tsx src/index.ts foundry generate --type faults --seeds 1 && FOUNDRY_FAULTS=1 tsx src/index.ts foundry report --last 1"
  },
  "dependencies": {
    "@jobforge/sdk-ts": "workspace:*",
    "@settler/sdk": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "dotenv": "^17.3.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "reconciliation",
    "cli",
    "command-line",
    "payments",
    "ecommerce"
  ],
  "license": "MIT"
}
