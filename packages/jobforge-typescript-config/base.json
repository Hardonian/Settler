{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@jobforge/sdk-ts": ["../jobforge-sdk-ts/src"],
      "@jobforge/shared": ["../jobforge-shared/src"],
      "@jobforge/errors": ["../jobforge-errors/src"],
      "@jobforge/fetch": ["../jobforge-fetch/src"]
    }
  },
  "exclude": ["node_modules"]
}
