{
  "name": "@settler/proofs",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "default": "./dist/canonical-json.js"
    },
