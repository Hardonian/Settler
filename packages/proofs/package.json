    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.111",
    "@settler/types": "workspace:*",
    "ai": "^7.0.165"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
