{
  "name": "@settler/proofs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence/index.d.ts",
      "default": "./dist/evidence/index.js"
    },
    "./proofpack": {
      "types": "./dist/proofpack/index.d.ts",
      "default": "./dist/proofpack/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@settler/types": "workspace:*",
    "ai": "^6.0.199"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
