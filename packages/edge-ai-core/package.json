{
  "name": "@settler/edge-ai-core",
  "version": "1.0.0",
  "description": "Brand-neutral Edge AI core engine - shared technical components for model optimization, inference, and device management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "pnpm run typecheck",
    "build": "node ../../scripts/run-package-tsc-build.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@types/node": "^26.4.0",
    "ai": "^7.0.85",
    "typescript": "^5.9.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "edge-ai",
    "model-optimization",
    "inference",
    "device-profiling"
  ],
  "license": "MIT"
}
