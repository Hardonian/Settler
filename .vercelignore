# Vercel ignore file
# Files and directories to exclude from Vercel deployments

# Build artifacts
.next/
dist/
build/
.turbo/

# Dependencies
node_modules/

# Development files
.env.local
.env.development
.env.test

# Git
.git/
.gitignore

# Documentation
*.md
!README.md
/docs/
/business/
/marketing/
/strategic/

# Test files
tests/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# CI/CD (not needed in deployment)
.github/

# Scripts - include only build-time scripts needed for Vercel builds
# First, explicitly include the scripts we need
!scripts/vercel-prisma-postinstall.js
!scripts/vercel-build-optimizer.js
!scripts/vercel-install.sh
!scripts/validate-api-routes.ts
# Then ignore everything else in scripts
scripts/*

# Other
.DS_Store
*.log
coverage/
