{
  "name": "settler-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Reconciliation-as-a-Service API - Complete monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:reality": "playwright test tests/e2e/frontend-reality-gates.spec.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:csv-upload": "tsx scripts/test-csv-upload.ts",
    "test:smoke:console": "playwright test tests/e2e/console-smoke.spec.ts",
    "stripe:listen": "tsx scripts/stripe-test-harness.ts listen",
    "stripe:test": "tsx scripts/stripe-test-harness.ts test",
    "validate:billing": "tsx scripts/validate-billing-reality.ts",
    "validate:onboarding": "tsx scripts/validate-onboarding-reality.ts",
    "validate:tenant-isolation": "tsx scripts/validate-tenant-isolation.ts",
    "validate:failure-injection": "tsx scripts/validate-failure-injection.ts",
    "validate:all": "npm run validate:eslint-config && npm run validate:build-safety && npm run validate:nextjs && npm run validate:lint-config && npm run validate:comprehensive",
    "doctor": "node scripts/doctor.mjs",
    "doctor:old": "tsx scripts/doctor.ts",
    "diagnose:console": "tsx scripts/diagnose-console-backend.ts",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "verify:contracts": "tsx scripts/check-contract-compatibility.ts",
    "verify:production-parity": "tsx scripts/verify-production-parity.ts",
    "verify:schema-introspect": "tsx scripts/introspect-production-schema.ts",
    "verify:frontend-contracts": "tsx scripts/map-frontend-backend-contracts.ts",
    "verify:edge-functions": "tsx scripts/verify-edge-functions.ts",
    "verify:pipe-dreams": "tsx scripts/find-pipe-dream-signals.ts",
    "migrations:consolidate": "tsx scripts/consolidate-migrations.ts",
    "monitor:errors": "tsx scripts/monitor-api-errors.ts",
    "check:production": "tsx scripts/check-production-readiness.ts",
    "repo-integrity": "tsx scripts/repo-integrity.ts",
    "vercel:parity": "tsx scripts/vercel-parity.ts",
    "check:workspace": "tsx scripts/check-workspace-integrity.ts",
    "test:visual": "playwright test --project=visual-regression",
    "test:visual:update": "playwright test --project=visual-regression --update-snapshots",
    "qa:crawl": "tsx scripts/qa-crawler.ts",
    "qa:crawl:local": "tsx scripts/qa-crawler.ts http://localhost:3000",
    "qa:crawl:live": "tsx scripts/qa-crawler.ts https://settler.dev",
    "qa:routes": "tsx scripts/qa-generate-route-registry.ts",
    "qa:links": "tsx scripts/qa-extract-links.ts && tsx scripts/qa-check-dead-links.ts",
    "qa:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "qa:reality": "tsx scripts/qa-reality-unified.ts",
    "qa:visual": "playwright test tests/e2e/visual.spec.ts --project=visual-regression",
    "qa:visual:update": "playwright test tests/e2e/visual.spec.ts --project=visual-regression --update-snapshots",
    "qa:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "qa:dom-reality": "playwright test --project=dom-reality tests/e2e/dom-reality-enforcement.spec.ts tests/e2e/dom-reality-regression-prevention.spec.ts tests/e2e/dom-reality-comprehensive.spec.ts",
    "qa:dom-reality:report": "tsx scripts/generate-dom-reality-report.ts",
    "qa:dom-reality:inspect": "tsx scripts/dom-reality-inspector.ts",
    "qa:dom-reality:ci": "tsx scripts/dom-reality-ci-integration.ts",
    "qa:dom-reality:check-env": "tsx scripts/load-env-for-tests.ts",
    "qa:all": "npm run qa:routes && npm run qa:links && npm run qa:smoke && npm run qa:visual && npm run qa:a11y && npm run qa:dom-reality",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "check": "npm run lint && npm run typecheck",
    "clean": "node scripts/clean.mjs",
    "clean:deps": "node scripts/clean.mjs --deps",
    "clean:all": "node scripts/clean.mjs --all",
    "verify": "node scripts/verify.mjs",
    "verify:skip-tests": "node scripts/verify.mjs --skip-tests",
    "verify:skip-build": "node scripts/verify.mjs --skip-build",
    "validate": "npm run lint && npm run typecheck && npm run format:check",
    "validate:env": "tsx scripts/check-env.ts production",
    "validate:env:build": "npx tsx scripts/validate-env-build.ts --build",
    "validate:env:runtime": "npx tsx scripts/validate-env-build.ts --runtime",
    "validate:eslint-config": "test -f scripts/validate-eslint-config.ts && npx tsx scripts/validate-eslint-config.ts || (echo '⚠️  ESLint config validation script not found (expected in Vercel builds), skipping...' && exit 0)",
    "validate:build-safety": "npx tsx scripts/validate-build-safety.ts",
    "validate:nextjs": "npx tsx scripts/validate-nextjs-build.ts",
    "validate:lint-config": "npx tsx scripts/validate-lint-config.ts",
    "validate:comprehensive": "npx tsx scripts/validate-comprehensive-build.ts",
    "prepare": "husky install 2>/dev/null || true",
    "db:new": "bash scripts/new-migration.sh",
    "db:verify": "tsx scripts/verify-backend-contract.ts",
    "db:verify:migrations": "bash scripts/verify-migrations.sh",
    "db:smoke": "tsx scripts/smoke-test-backend.ts",
    "db:test:rls": "tsx scripts/test-rls-policies.ts",
    "db:reconcile": "tsx scripts/verify-backend-contract.ts --reconcile && tsx scripts/generate-reconciliation-migration.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:dump": "supabase db dump -f supabase/schema.sql",
    "db:types": "supabase gen types typescript --project-id ${SUPABASE_PROJECT_REF:-your-project-ref} > src/types/database.types.ts",
    "db:migrate:local": "supabase migration up",
    "db:migrate:prod": "supabase db push --include-all",
    "db:migrate:auto": "tsx scripts/migrate-supabase.ts",
    "db:migrate:apply": "bash scripts/apply-migrations.sh",
    "db:migrate:pending": "tsx scripts/apply-migrations-with-check.ts",
    "db:migrate:all": "tsx scripts/apply-migrations-direct.ts",
    "db:migrate:onboarding": "npx tsx scripts/apply-onboarding-migration.ts",
    "db:types:regenerate": "npx tsx scripts/regenerate-supabase-types.ts",
    "deploy:vercel": "bash scripts/vercel-deploy.sh",
    "db:check": "tsx scripts/check-connection.ts",
    "db:sanity-check": "tsx scripts/db-sanity-check.ts",
    "prisma:generate": "PRISMA_CLIENT_ENGINE_TYPE=binary PRISMA_ENGINES_MIRROR= prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:status": "prisma migrate status",
    "preinstall": "export SENTRY_SKIP_AUTO_INSTALL=1 || set SENTRY_SKIP_AUTO_INSTALL=1 || true",
    "postinstall": "test -f scripts/vercel-prisma-postinstall.js && node scripts/vercel-prisma-postinstall.js || echo 'Skipping postinstall: script not found (expected in Vercel builds)'",
    "verify:build": "test -f scripts/verify-build-setup.sh && bash scripts/verify-build-setup.sh || echo '⚠️  Build verification script not available'",
    "setup:turbo": "test -f scripts/setup-vercel-turbo-cache.sh && bash scripts/setup-vercel-turbo-cache.sh || echo '⚠️  Turbo setup script not available'",
    "agents:deploy": "bash scripts/deploy-autonomous-agents.sh",
    "agents:setup": "tsx scripts/setup-autonomous-agents.ts",
    "agents:monitor": "bash scripts/monitor-agents.sh",
    "agents:run": "tsx scripts/run-agent.ts",
    "agents:status": "tsx scripts/run-agent.ts status",
    "classify": "tsx scripts/classify.ts",
    "operator-mode:daily": "cd packages/api && npm run operator-mode:daily",
    "operator-mode:setup-alerts": "tsx scripts/setup-operator-mode-alerts.ts",
    "test:operator-mode": "cd packages/api && npm run test:operator-mode",
    "ops:daily": "tsx scripts/ops-daily-report.ts",
    "ops:weekly": "tsx scripts/ops-weekly-report.ts",
    "ops:doctor": "tsx scripts/ops-doctor.ts",
    "ops:billing:evidence": "tsx scripts/ops-billing-evidence.ts",
    "ops:procurement:pack": "tsx scripts/ops-procurement-pack.ts",
    "ops:audit": "tsx scripts/code-quality-audit.ts",
    "classify:json": "tsx scripts/classify.ts --json",
    "classify:strict": "tsx scripts/classify.ts --strict",
    "classify:fix-suggestions": "tsx scripts/classify-fix-suggestions.ts",
    "mirror:dryrun": "tsx scripts/mirror-dryrun.ts",
    "mirror:verify": "tsx scripts/mirror-verify.ts",
    "mirror:publish": "tsx scripts/mirror-publish.ts",
    "setup:open-core": "bash scripts/setup-open-core.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.40.0",
    "@prisma/client": "^7.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^10.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "pg": "^8.16.3",
    "prettier": "^3.1.1",
    "prisma": "^7.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "turbo": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "overrides": {
    "rimraf": "^5.0.0",
    "raw-body": "^2.5.2",
    "hono": "^4.11.4",
    "qs": "^6.14.1",
    "body-parser": "^1.20.4",
    "tar": "^7.5.3"
  }
}
