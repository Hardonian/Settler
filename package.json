    "workhorse:maintenance": "cd packages/workhorse && python -m settler_workhorse.cli maintenance",
    "workhorse:smoke": "cd packages/workhorse && python tests/smoke_test.py",
    "workhorse:lint": "cd packages/workhorse && python -m ruff check src/ tests/",
    "workhorse:lint:fix": "cd packages/workhorse && python -m ruff check --fix src/ tests/",
    "workhorse:format": "cd packages/workhorse && python -m black src/ tests/",
    "workhorse:format:check": "cd packages/workhorse && python -m black --check src/ tests/",
    "workhorse:typecheck": "cd packages/workhorse && python -m mypy src/ --ignore-missing-imports",
    "workhorse:test": "cd packages/workhorse && python -m pytest tests/ -v",
    "workhorse:verify": "pnpm run workhorse:format:check && pnpm run workhorse:lint && pnpm run workhorse:typecheck",
