// ADD NEW MODELS AFTER ReconResult:

model RunSnapshot {
  id                    String    @id @default(uuid())
  tenantId              String    @db.Uuid
  reconJobId            String    @db.Uuid
  inputHash             String    @unique
  sourceDataHash        String
  targetDataHash        String
  adapterConfigHashes   Json      @default("{}")
  jobConfig             Json      @default("{}")
  ruleVersions          Json      @default("[]")
  engineVersion         String    @default("1.0.0")
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now())

  results               ReconResult[]

  @@index([tenantId])
  @@index([reconJobId])
  @@index([inputHash])
  @@index([createdAt(sort: Desc)])
  @@map("run_snapshots")
}

model ExecutionProvenance {
  id                    String    @id @default(uuid())
  tenantId              String    @db.Uuid
  runResultId           String    @db.Uuid
  snapshotId            String    @db.Uuid
  sequence              Int
  operation             String
  entityType            String
  entityId              String    @db.Uuid
  ruleId                String?   @db.Uuid
  ruleVersion           Int?
  confidence            Decimal?  @db.Decimal(5, 4)
  actor                 String    @default("system")
  actorUserId           String?   @db.Uuid
  details               Json      @default("{}")
  entryHash             String
  timestamp             DateTime  @default(now())

  runResult             ReconResult @relation(fields: [runResultId], references: [id], onDelete: Cascade)

  @@unique([runResultId, sequence])
  @@index([tenantId])
  @@index([runResultId])
  @@index([snapshotId])
  @@index([operation])
  @@index([entityId])
  @@index([timestamp])
  @@map("execution_provenance")
}

