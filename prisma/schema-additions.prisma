// ============================================================================
// ANALYTICS & CHATBOT MODELS
// ============================================================================
// Add these models to your main schema.prisma file

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  data      Json     @default("{}")
  userId    String?  @db.Uuid
  sessionId String?
  timestamp DateTime @default(now())
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
  @@map("analytics_events")
}

model SDKDownload {
  id            String   @id @default(cuid())
  packageName   String
  version       String
  packageManager String
  userId        String?  @db.Uuid
  sessionId     String?
  userAgent     String?
  referrer      String?
  ipAddress     String?
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([packageName])
  @@index([timestamp])
  @@index([userId])
  @@map("sdk_downloads")
}

model PlaygroundUsage {
  id          String   @id @default(cuid())
  feature     String
  action      String
  integration String?
  durationMs  Int?
  success     Boolean?
  userId      String?  @db.Uuid
  sessionId   String?
  metadata    Json?    @default("{}")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([feature])
  @@index([timestamp])
  @@index([userId])
  @@map("playground_usage")
}

model ChatbotConversation {
  id            String   @id @default(cuid())
  conversationId String
  message       String   @db.Text
  response      String   @db.Text
  userId        String?  @db.Uuid
  sessionId     String?
  deviceInfo    Json?    @default("{}")
  metadata      Json?    @default("{}")
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([conversationId])
  @@index([timestamp])
  @@index([userId])
  @@map("chatbot_conversations")
}

model ChatbotAnalytics {
  id        String   @id @default(cuid())
  type      String
  data      Json     @default("{}")
  sessionId String?
  userId    String?  @db.Uuid
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@index([sessionId])
  @@map("chatbot_analytics")
}

model NewsletterSubscription {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  source          String?
  tags            String[]
  resendContactId String?
  subscribed      Boolean   @default(true)
  unsubscribedAt  DateTime?
  metadata        Json?     @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([subscribed])
  @@map("newsletter_subscriptions")
}
