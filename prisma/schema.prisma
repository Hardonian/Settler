// ============================================================================
// EVIDENCE & PROOF PACKAGE MODELS
// Structured evidence capture for audit and compliance
// ============================================================================

model EvidenceArtifact {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  artifactType      String     @map("artifact_type") // "source_snapshot", "target_snapshot", "match_comparison", "operator_annotation", "system_analysis"
  
  // Core evidence data
  artifactKey       String     @map("artifact_key") // Unique key within tenant for deduplication
  payload           Json      // Structured evidence payload
  payloadHash       String     @map("payload_hash") // SHA-256 hash of payload for integrity
  payloadSizeBytes  Int?       @map("payload_size_bytes") // Size for storage accounting
  
  // Provenance tracking
  sourceType        String?    @map("source_type") // Where this evidence came from
  sourceId          String?    @map("source_id") // External reference ID
  capturedBy        String    @default("system")  @map("captured_by") // system, operator, automated_rule
  capturedByUserId   String?   @db.Uuid @map("captured_by_user_id")
  
  // Run context
  runId             String?   @db.Uuid @map("run_id")
  exceptionId       String?   @db.Uuid @map("exception_id")
  
  // Freshness and validity
  capturedAt        DateTime  @default(now()) @map("captured_at")
  validFrom        DateTime  @default(now()) @map("valid_from")
  validUntil       DateTime?  @map("valid_until") // Null = indefinitely valid
  isExpired         Boolean   @default(false) @map("is_expired")
  expiredAt         DateTime? @map("expired_at")
  
  // Reliability scoring
  reliabilityScore  Decimal?   @db.Decimal(5, 4)  @map("reliability_score") // 0-1 confidence in artifact accuracy
  reliabilityFactors Json      @default("[]")  @map("reliability_factors") // Factors affecting reliability
  
  // Degradation tracking
  degraded          Boolean   @default(false)
  degradedReasons   Json     @default("[]")  @map("degraded_reasons") // Why degraded
  degradedAt         DateTime? @map("degraded_at")
  
  // Attestation
  attested          Boolean   @default(false)
  attestedBy        String?   @db.Uuid @map("attested_by")
  attestedAt        DateTime? @map("attested_at")
  attestationMethod String?    @map("attestation_method") // manual, automated, cryptographic
  
  // Versioning
  version           Int       @default(1)
  supersededBy      String?   @db.Uuid  @map("superseded_by") // ID of newer version
  supersededAt      DateTime? @map("superseded_at")
  
  metadata          Json       @default("{}")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, artifactKey])
  @@index([tenantId])
  @@index([artifactType])
  @@index([runId])
  @@index([exceptionId])
  @@index([capturedAt(sort: Desc)])
  @@index([isExpired])
  @@map("evidence_artifacts")
}

model ProofPackage {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  
  // Package identity
  packageType       String     @map("package_type") // "run_summary", "exception_resolution", "audit_export", "compliance_report"
