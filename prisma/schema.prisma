}

model ApprovalDelegation {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  delegatorId       String    @db.Uuid  @map("delegator_id") // Original approver
  delegateId        String    @db.Uuid  @map("delegate_id") // Person delegated to
  role              String    // Role being delegated
  
  // Delegation scope
  scope             Json      @default("{}") // Limitations on delegation
  requestTypes      Json      @default("[]")  @map("request_types") // Which request types can be delegated
  
  // Timing
  validFrom         DateTime  @default(now()) @map("valid_from")
  validUntil        DateTime? @map("valid_until")
  isActive          Boolean   @default(true) @map("is_active")
  
  // Constraints
  maxDelegations    Int       @default(1)  @map("max_delegations") // How many times this can be used
  usedCount         Int       @default(0) @map("used_count")
  
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, delegatorId, delegateId, role])
  @@index([tenantId])
  @@index([delegatorId])
  @@index([delegateId])
  @@index([isActive])
  @@map("approval_delegations")
}

// ============================================================================
// OPERATOR CUSTOMIZATION STUDIO
// Versioned presentation/workflow layout for admin console; tenant + user scoped.
// Does not store reconciliation truth — only module visibility, order, labels, thresholds.
// ============================================================================

model OperatorCustomizationState {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid @map("tenant_id")
  userId           String    @db.Uuid @map("user_id")
  surface          String // e.g. admin_dashboard
  schemaVersion    String    @default("1") @map("schema_version")
  draftConfig      Json      @default("{}") @map("draft_config")
  publishedConfig  Json      @default("{}") @map("published_config")
  publishedAt      DateTime? @map("published_at")
  draftUpdatedAt   DateTime  @default(now()) @map("draft_updated_at")
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, surface])
  @@index([tenantId])
  @@index([userId])
  @@map("operator_customization_states")
}

model OperatorCustomizationProposal {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid @map("tenant_id")
  userId                 String    @db.Uuid @map("user_id")
  surface                String
  status                 String    @default("pending") // pending, applied, rejected
  naturalLanguageRequest String    @db.Text @map("natural_language_request")
  structuredPatch        Json      @default("{}") @map("structured_patch")
  rationale              String?   @db.Text
  inferenceMode          String    @default("rules")  @map("inference_mode") // rules | degraded_unavailable | premium_llm (future lane)
  proposalLane           String    @default("rules")  @map("proposal_lane") // rules | premium_llm — packaging / audit only; never auto-publish
  explanationEvidence    Json      @default("{}")  @map("explanation_evidence") // bounded metadata: matched rule ids, registry version, etc.
  createdAt              DateTime  @default(now()) @map("created_at")
  appliedAt              DateTime? @map("applied_at")
  rejectedAt             DateTime? @map("rejected_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([status])
  @@map("operator_customization_proposals")
}

model OperatorCustomizationAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String?  @db.Uuid @map("user_id")
  action    String
  surface   String?
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("operator_customization_audits")
}

model OperatorInteractionSignal {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  userId     String?  @db.Uuid @map("user_id")
  signalType String  @map("signal_type") // module_view, layout_reorder, etc.
  moduleId   String @map("module_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, moduleId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("operator_interaction_signals")
}

/** Durable dismissal of a suggestion (tenant + user); not reconciliation truth. */
model OperatorSuggestionDismissal {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid @map("tenant_id")
  userId          String   @db.Uuid  @map("user_id") // actor who dismissed (same scope as customization draft)
  surface         String
  suggestionKind  String  @map("suggestion_kind") // e.g. pin_module
  suggestionKey   String  @map("suggestion_key") // e.g. module_id for pin_module
  reasonCategory  String? @map("reason_category")
  metadata        Json     @default("{}")
  dismissedAt     DateTime @default(now()) @map("dismissed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, surface, suggestionKind, suggestionKey])
  @@index([tenantId, userId, surface])
  @@map("operator_suggestion_dismissals")
}

