model EvidenceArtifact {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  artifactType      String    // "source_snapshot", "target_snapshot", "match_comparison", "operator_annotation", "system_analysis"
  
  // Core evidence data
  artifactKey       String    // Unique key within tenant for deduplication
  payload           Json      // Structured evidence payload
  payloadHash       String    // SHA-256 hash of payload for integrity
  payloadSizeBytes  Int?      // Size for storage accounting
  
  // Provenance tracking
  sourceType        String?   // Where this evidence came from
  sourceId          String?   // External reference ID
  capturedBy        String    @default("system") // system, operator, automated_rule
  capturedByUserId   String?   @db.Uuid
  
  // Run context
  runId             String?   @db.Uuid
  exceptionId       String?   @db.Uuid
  
  // Freshness and validity
  capturedAt        DateTime  @default(now())
  validFrom        DateTime  @default(now())
  validUntil       DateTime? // Null = indefinitely valid
  isExpired         Boolean   @default(false)
  expiredAt         DateTime?
  
  // Reliability scoring
  reliabilityScore  Decimal?   @db.Decimal(5, 4) // 0-1 confidence in artifact accuracy
  reliabilityFactors Json      @default("[]") // Factors affecting reliability
  
  // Degradation tracking
  degraded          Boolean   @default(false)
