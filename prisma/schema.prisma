// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// BILLING INFRASTRUCTURE MODELS
// ============================================================================

model BillingAccount {
  id                String    @id @default(uuid())
  userId            String    @db.Uuid
  tenantId          String?   @db.Uuid
  stripeCustomerId  String?   @unique
  stripeAccountId   String?
  email             String
  name              String?
  address           Json?
  taxId             String?
  currency          String    @default("usd")
  status            String    @default("active") // active, suspended, cancelled
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  subscriptions     Subscription[]
  addOnPurchases    AddOnPurchase[]
  usageEvents       UsageEvent[]
  usageAggregates   UsageAggregateDaily[]

  @@index([userId])
  @@index([tenantId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("billing_accounts")
}

model Subscription {
  id                    String    @id @default(uuid())
  billingAccountId      String    @db.Uuid
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  planId                String    // base, pro, enterprise
  planName              String    // "Settler Core"
  status                String    // active, cancelled, past_due, trialing
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  cancelledAt           DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  billingAccount        BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model AddOn {
  id                String    @id @default(uuid())
  integrationId     String    @unique // tiktok, wix, ga4, paypal-payouts, whatsapp-telegram
  name              String    // "TikTok Shop + TikTok Ads"
  description       String?
  category          String    // integration, feature, support
  basePriceMonthly  Decimal   @db.Decimal(10, 2)
  usagePricePerUnit Decimal?  @db.Decimal(10, 6) // per order, per event, etc.
  usageUnit         String?   // order, event, message, payout
  stripeProductId   String?
  stripePriceId     String?
  isActive          Boolean   @default(true)
  isStandard        Boolean   @default(false) // true if included in base plan
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchases         AddOnPurchase[]

  @@index([integrationId])
  @@index([isActive])
  @@index([isStandard])
  @@map("add_ons")
}

model AddOnPurchase {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  addOnId           String    @db.Uuid
  stripeSubscriptionItemId String? @unique
  status            String    @default("active") // active, cancelled, expired
  purchasedAt       DateTime  @default(now())
  cancelledAt       DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  addOn             AddOn @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  @@index([billingAccountId])
  @@index([addOnId])
  @@index([status])
  @@map("add_on_purchases")
}

model UsageEvent {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  projectId         String?   @db.Uuid
  userId            String?   @db.Uuid
  tenantId          String?   @db.Uuid
  eventType        String    // auth_user_created, db_query, webhook_event, ai_request, etc.
  integrationId     String?   // stripe, shopify, tiktok, etc.
  addOnId           String?   @db.Uuid
  quantity          Decimal   @db.Decimal(15, 6) // can be fractional
  unit              String?   // request, job, event, message, etc.
  metadata          Json?
  timestamp         DateTime  @default(now())
  aggregated        Boolean   @default(false) // true once aggregated into daily table

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([projectId])
  @@index([userId])
  @@index([tenantId])
  @@index([eventType])
  @@index([integrationId])
  @@index([timestamp])
  @@index([aggregated])
  @@index([billingAccountId, eventType, timestamp])
  @@map("usage_events")
}

model UsageAggregateDaily {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  projectId         String?   @db.Uuid
  tenantId          String?   @db.Uuid
  date              DateTime  @db.Date
  eventType         String
  integrationId     String?
  addOnId           String?   @db.Uuid
  totalQuantity     Decimal   @db.Decimal(15, 6)
  eventCount        Int       @default(0)
  estimatedCost     Decimal?  @db.Decimal(10, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, projectId, date, eventType, integrationId, addOnId])
  @@index([billingAccountId])
  @@index([projectId])
  @@index([tenantId])
  @@index([date])
  @@index([eventType])
  @@index([integrationId])
  @@map("usage_aggregate_daily")
}

// ============================================================================
// RECON CORE ENGINE MODELS
// Phase I: Foundational Recon Core Engine
// ============================================================================

model ReconJob {
  id                String    @id @default(uuid())
  tenantId           String    @db.Uuid
  userId             String    @db.Uuid
  name               String
  description        String?
  templateId         String?   @db.Uuid
  sourceAdapter      String
  sourceConfigEncrypted String @db.Text
  targetAdapter      String
  targetConfigEncrypted String @db.Text
  mappingTemplateId  String?   @db.Uuid
  transformRecipeId  String?   @db.Uuid
  validationRules    Json      @default("[]")
  reconStrategy      String    @default("deterministic")
  scheduleCron       String?
  scheduleTimezone   String    @default("UTC")
  status             String    @default("active")
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  template           ReconTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mappingTemplate    MappingTemplate? @relation(fields: [mappingTemplateId], references: [id], onDelete: SetNull)
  transformRecipe    TransformRecipe? @relation(fields: [transformRecipeId], references: [id], onDelete: SetNull)
  results            ReconResult[]
  audits             ReconAudit[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([templateId])
  @@map("recon_jobs")
}

model ReconResult {
  id                    String    @id @default(uuid())
  reconJobId            String    @db.Uuid
  tenantId              String    @db.Uuid
  executionId           String?   @db.Uuid
  status                String    @default("running")
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  sourceCount           Int       @default(0)
  targetCount           Int       @default(0)
  matchedCount          Int       @default(0)
  unmatchedSourceCount  Int       @default(0)
  unmatchedTargetCount  Int       @default(0)
  conflictCount         Int       @default(0)
  totalAmountSource     Decimal?  @db.Decimal(15, 2)
  totalAmountTarget     Decimal?  @db.Decimal(15, 2)
  totalAmountMatched    Decimal?  @db.Decimal(15, 2)
  totalAmountUnmatched  Decimal?  @db.Decimal(15, 2)
  currency              String?
  confidenceAvg         Decimal?  @db.Decimal(5, 4)
  confidenceMin         Decimal?  @db.Decimal(5, 4)
  confidenceMax         Decimal?  @db.Decimal(5, 4)
  durationMs            BigInt?
  errorMessage          String?   @db.Text
  errorStack            String?   @db.Text
  summary               Json      @default("{}")
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  reconJob              ReconJob @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  audits                ReconAudit[]

  @@index([reconJobId])
  @@index([tenantId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("recon_results")
}

model ReconTemplate {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  name              String
  description       String?
  category          String?
  sourceAdapterType String?
  targetAdapterType String?
  reconStrategy     String    @default("deterministic")
  matchingRules     Json      @default("[]")
  validationRules   Json      @default("[]")
  transformRules    Json      @default("[]")
  isPublic          Boolean   @default(false)
  isSystem          Boolean   @default(false)
  usageCount        Int       @default(0)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([category])
  @@index([isPublic])
  @@map("recon_templates")
}

model ReconAudit {
  id            String    @id @default(uuid())
  reconJobId    String?   @db.Uuid
  reconResultId String?   @db.Uuid
  tenantId      String    @db.Uuid
  userId        String?   @db.Uuid
  auditType     String
  action        String
  entityType    String?
  entityId      String?   @db.Uuid
  changes       Json?
  beforeState   Json?
  afterState    Json?
  ipAddress     String?
  userAgent     String?   @db.Text
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())

  reconJob      ReconJob? @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  reconResult   ReconResult? @relation(fields: [reconResultId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([reconResultId])
  @@index([auditType])
  @@index([createdAt(sort: Desc)])
  @@map("recon_audits")
}

model MappingTemplate {
  id                String    @id @default(uuid())
  tenantId           String?   @db.Uuid
  name               String
  description        String?
  sourceSchema       Json
  targetSchema       Json
  fieldMappings      Json      @default("{}")
  transformationRules Json     @default("[]")
  validationRules    Json      @default("[]")
  isPublic           Boolean   @default(false)
  isSystem           Boolean   @default(false)
  usageCount         Int       @default(0)
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  jobs               ReconJob[]

  @@index([tenantId])
  @@index([isPublic])
  @@map("mapping_templates")
}

model ValidationRule {
  id          String    @id @default(uuid())
  tenantId    String?   @db.Uuid
  name        String
  description String?
  ruleType    String
  ruleConfig  Json
  severity    String    @default("error")
  isActive    Boolean   @default(true)
  isPublic    Boolean   @default(false)
  isSystem    Boolean   @default(false)
  usageCount  Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([ruleType])
  @@index([isActive])
  @@index([isPublic])
  @@map("validation_rules")
}

model TransformRecipe {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  name              String
  description       String?
  recipeType        String
  inputSchema       Json
  outputSchema      Json
  transformationSteps Json    @default("[]")
  validationRules   Json      @default("[]")
  isPublic          Boolean   @default(false)
  isSystem          Boolean   @default(false)
  usageCount        Int       @default(0)
  version           Int       @default(1)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([recipeType])
  @@index([isPublic])
  @@map("transform_recipes")
}

model ContractVersion {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  contractName      String
  version           String
  schemaDefinition  Json
  isActive          Boolean   @default(true)
  isDeprecated      Boolean   @default(false)
  deprecatedAt      DateTime?
  breakingChanges   Json      @default("[]")
  migrationGuide    String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  driftEvents       DriftEvent[]

  @@unique([tenantId, contractName, version])
  @@index([tenantId])
  @@index([contractName])
  @@index([isActive])
  @@map("contract_versions")
}

model DriftEvent {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  reconJobId        String?   @db.Uuid
  contractVersionId String?   @db.Uuid
  driftType         String
  severity          String    @default("warning")
  fieldPath         String?
  expectedValue     Json?
  actualValue       Json?
  driftMetrics      Json      @default("{}")
  autoRepaired      Boolean   @default(false)
  repairAction      Json?
  acknowledged      Boolean   @default(false)
  acknowledgedBy    String?   @db.Uuid
  acknowledgedAt     DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  contractVersion   ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([driftType])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@index([acknowledged])
  @@map("drift_events")
}

model WorkflowRun {
  id            String    @id @default(uuid())
  tenantId      String    @db.Uuid
  workflowId    String
  workflowName  String?
  workflowVersion String?
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  triggeredBy   String?
  triggerEvent  Json?
  executionGraph Json?
  stepResults   Json      @default("{}")
  errorMessage  String?   @db.Text
  errorStack    String?   @db.Text
  durationMs    BigInt?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([workflowId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("workflow_runs")
}
