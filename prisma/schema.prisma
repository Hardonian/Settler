// ============================================================================
// FEATURE FLAGS API MODELS
// Feature flag management for Settler Feature Flags API (free developer toolkit)
// ============================================================================

model FeatureFlag {
  id                String    @id @default(uuid())
  billingAccountId  String?   @db.Uuid // Optional: for usage tracking
  projectId         String?   @db.Uuid // Optional: for project-scoped flags
  key               String    // e.g., "new-dashboard", "enable-beta-feature"
  name              String
  description       String?
  type              String    @default("boolean") // boolean, string, number
  isGlobal          Boolean   @default(false) // true if applies to all projects
  defaultValue      Json?     // Default value for the flag
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  environments      FeatureFlagEnvironment[]
  overrides         FeatureFlagOverride[]

  @@unique([billingAccountId, projectId, key])
  @@index([billingAccountId])
  @@index([projectId])
  @@index([key])
  @@index([isGlobal])
  @@index([deletedAt])
  @@map("feature_flags")
}

model FeatureFlagEnvironment {
  id                String    @id @default(uuid())
  flagId            String    @db.Uuid
  environment       String    // e.g., "production", "staging", "development"
  enabled           Boolean   @default(false)
  variant           Json?     // For string/number flags, the variant value
  config            Json      @default("{}") // Additional environment-specific config
  updatedAt         DateTime  @updatedAt
  updatedBy         String?   @db.Uuid

  flag              FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, environment])
  @@index([flagId])
  @@index([environment])
  @@index([enabled])
  @@map("feature_flag_environments")
}

model FeatureFlagOverride {
  id                String    @id @default(uuid())
  flagId            String    @db.Uuid
  environment       String
  targetKey         String    // userId, tenantId, or other identifier
  targetType        String    @default("user") // user, tenant, segment, etc.
  value             Json      // The override value
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?

  flag              FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, environment, targetKey, targetType])
  @@index([flagId])
  @@index([environment])
  @@index([targetKey])
  @@index([expiresAt])
  @@map("feature_flag_overrides")
}

// ============================================================================
// MULTI-TENANT & WHITE-LABEL SITE BUILDER MODELS
// Multi-tenant front-end configuration, page builder, and A/B testing
// ============================================================================

model Tenant {
  id                String    @id @default(uuid())
  billingAccountId  String?   @unique @db.Uuid // Optional: link to billing account
  slug               String    @unique // e.g., "default", "partner-x"
  primaryDomain      String?   // e.g., "settler.dev"
  customDomain       String?   // e.g., "api.partnerx.com"
  name               String
  isActive            Boolean   @default(true)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  billingAccount     BillingAccount? @relation(fields: [billingAccountId], references: [id], onDelete: SetNull)
  branding           TenantBranding?
  navigation         TenantNavigation?
  pages              TenantPage[]
  experiments        Experiment[]

  @@index([slug])
  @@index([primaryDomain])
  @@index([customDomain])
  @@index([billingAccountId])
  @@index([isActive])
  @@map("tenants")
}

model OnboardingProgress {
