// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// BILLING INFRASTRUCTURE MODELS
// ============================================================================

model BillingAccount {
  id                String    @id @default(uuid())
  userId            String    @db.Uuid
  tenantId          String?   @db.Uuid // Legacy field, consider migrating to Tenant.billingAccountId
  stripeCustomerId  String?   @unique
  stripeAccountId   String?
  email             String
  name              String?
  address           Json?
  taxId             String?
  currency          String    @default("usd")
  status            String    @default("active") // active, suspended, cancelled
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant            Tenant?   // Optional relation to Tenant model
  subscriptions     Subscription[]
  addOnPurchases    AddOnPurchase[]
  usageEvents       UsageEvent[]
  usageAggregates   UsageAggregateDaily[]
  usageCounters     UsageCounter[]

  @@index([userId])
  @@index([tenantId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("billing_accounts")
}

model Subscription {
  id                    String    @id @default(uuid())
  billingAccountId      String    @db.Uuid
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  planId                String    // base, pro, enterprise
  planName              String    // "Settler Core"
  status                String    // active, cancelled, past_due, trialing
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  cancelledAt           DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  billingAccount        BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model StripeEvent {
  id            String    @id @default(uuid())
  eventId       String    @unique // Stripe event.id
  type          String    // Event type (e.g., checkout.session.completed)
  status        String    @default("received") // received, processed, failed
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  error         String?   @db.Text
  userId        String?   @db.Uuid
  tenantId      String?   @db.Uuid
  billingAccountId String? @db.Uuid
  rawPayload    Json?     // Full event payload for debugging
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([eventId])
  @@index([type])
  @@index([status])
  @@index([receivedAt])
  @@index([userId])
  @@index([tenantId])
  @@index([billingAccountId])
  @@map("stripe_events")
}

model AddOn {
  id                String    @id @default(uuid())
  integrationId     String    @unique // tiktok, wix, ga4, paypal-payouts, whatsapp-telegram
  name              String    // "TikTok Shop + TikTok Ads"
  description       String?
  category          String    // integration, feature, support
  basePriceMonthly  Decimal   @db.Decimal(10, 2)
  usagePricePerUnit Decimal?  @db.Decimal(10, 6) // per order, per event, etc.
  usageUnit         String?   // order, event, message, payout
  stripeProductId   String?
  stripePriceId     String?
  isActive          Boolean   @default(true)
  isStandard        Boolean   @default(false) // true if included in base plan
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchases         AddOnPurchase[]

  @@index([integrationId])
  @@index([isActive])
  @@index([isStandard])
  @@map("add_ons")
}

model AddOnPurchase {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  addOnId           String    @db.Uuid
  stripeSubscriptionItemId String? @unique
  status            String    @default("active") // active, cancelled, expired
  purchasedAt       DateTime  @default(now())
  cancelledAt       DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  addOn             AddOn @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  @@index([billingAccountId])
  @@index([addOnId])
  @@index([status])
  @@map("add_on_purchases")
}

model UsageEvent {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  projectId         String?   @db.Uuid
  userId            String?   @db.Uuid
  tenantId          String?   @db.Uuid
  eventType        String    // auth_user_created, db_query, webhook_event, ai_request, etc.
  integrationId     String?   // stripe, shopify, tiktok, etc.
  addOnId           String?   @db.Uuid
  quantity          Decimal   @db.Decimal(15, 6) // can be fractional
  unit              String?   // request, job, event, message, etc.
  metadata          Json?
  timestamp         DateTime  @default(now())
  aggregated        Boolean   @default(false) // true once aggregated into daily table

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([projectId])
  @@index([userId])
  @@index([tenantId])
  @@index([eventType])
  @@index([integrationId])
  @@index([timestamp])
  @@index([aggregated])
  @@index([billingAccountId, eventType, timestamp])
  @@map("usage_events")
}

model UsageAggregateDaily {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  projectId         String?   @db.Uuid
  tenantId          String?   @db.Uuid
  date              DateTime  @db.Date
  eventType         String
  integrationId     String?
  addOnId           String?   @db.Uuid
  totalQuantity     Decimal   @db.Decimal(15, 6)
  eventCount        Int       @default(0)
  estimatedCost     Decimal?  @db.Decimal(10, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, projectId, date, eventType, integrationId, addOnId])
  @@index([billingAccountId])
  @@index([projectId])
  @@index([tenantId])
  @@index([date])
  @@index([eventType])
  @@index([integrationId])
  @@map("usage_aggregate_daily")
}

model UsageCounter {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  service           String    // 'reconcile', 'receipts', 'featureFlags', 'playground'
  period            String    // 'daily', 'monthly'
  periodStart       DateTime  @db.Date
  count             Int       @default(0)
  limit             Int       @default(0) // Cached limit for reference
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, service, period, periodStart])
  @@index([billingAccountId, service, period])
  @@index([periodStart])
  @@map("usage_counters")
}

// ============================================================================
// RECON CORE ENGINE MODELS
// Phase I: Foundational Recon Core Engine
// ============================================================================

model ReconJob {
  id                String    @id @default(uuid())
  tenantId           String    @db.Uuid
  userId             String    @db.Uuid
  name               String
  description        String?
  templateId         String?   @db.Uuid
  sourceAdapter      String
  sourceConfigEncrypted String @db.Text
  targetAdapter      String
  targetConfigEncrypted String @db.Text
  mappingTemplateId  String?   @db.Uuid
  transformRecipeId  String?   @db.Uuid
  validationRules    Json      @default("[]")
  reconStrategy      String    @default("deterministic")
  scheduleCron       String?
  scheduleTimezone   String    @default("UTC")
  status             String    @default("active")
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  template           ReconTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mappingTemplate    MappingTemplate? @relation(fields: [mappingTemplateId], references: [id], onDelete: SetNull)
  transformRecipe    TransformRecipe? @relation(fields: [transformRecipeId], references: [id], onDelete: SetNull)
  results            ReconResult[]
  audits             ReconAudit[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([templateId])
  @@map("recon_jobs")
}

model ReconResult {
  id                    String    @id @default(uuid())
  reconJobId            String    @db.Uuid
  tenantId              String    @db.Uuid
  executionId           String?   @db.Uuid
  status                String    @default("running")
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  sourceCount           Int       @default(0)
  targetCount           Int       @default(0)
  matchedCount          Int       @default(0)
  unmatchedSourceCount  Int       @default(0)
  unmatchedTargetCount  Int       @default(0)
  conflictCount         Int       @default(0)
  totalAmountSource     Decimal?  @db.Decimal(15, 2)
  totalAmountTarget     Decimal?  @db.Decimal(15, 2)
  totalAmountMatched    Decimal?  @db.Decimal(15, 2)
  totalAmountUnmatched  Decimal?  @db.Decimal(15, 2)
  currency              String?
  confidenceAvg         Decimal?  @db.Decimal(5, 4)
  confidenceMin         Decimal?  @db.Decimal(5, 4)
  confidenceMax         Decimal?  @db.Decimal(5, 4)
  durationMs            BigInt?
  errorMessage          String?   @db.Text
  errorStack            String?   @db.Text
  summary               Json      @default("{}")
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  reconJob              ReconJob @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  audits                ReconAudit[]

  @@index([reconJobId])
  @@index([tenantId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("recon_results")
}

model ReconTemplate {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  name              String
  description       String?
  category          String?
  sourceAdapterType String?
  targetAdapterType String?
  reconStrategy     String    @default("deterministic")
  matchingRules     Json      @default("[]")
  validationRules   Json      @default("[]")
  transformRules    Json      @default("[]")
  isPublic          Boolean   @default(false)
  isSystem          Boolean   @default(false)
  usageCount        Int       @default(0)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([category])
  @@index([isPublic])
  @@map("recon_templates")
}

model ReconAudit {
  id            String    @id @default(uuid())
  reconJobId    String?   @db.Uuid
  reconResultId String?   @db.Uuid
  tenantId      String    @db.Uuid
  userId        String?   @db.Uuid
  auditType     String
  action        String
  entityType    String?
  entityId      String?   @db.Uuid
  changes       Json?
  beforeState   Json?
  afterState    Json?
  ipAddress     String?
  userAgent     String?   @db.Text
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())

  reconJob      ReconJob? @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  reconResult   ReconResult? @relation(fields: [reconResultId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([reconResultId])
  @@index([auditType])
  @@index([createdAt(sort: Desc)])
  @@map("recon_audits")
}

model MappingTemplate {
  id                String    @id @default(uuid())
  tenantId           String?   @db.Uuid
  name               String
  description        String?
  sourceSchema       Json
  targetSchema       Json
  fieldMappings      Json      @default("{}")
  transformationRules Json     @default("[]")
  validationRules    Json      @default("[]")
  isPublic           Boolean   @default(false)
  isSystem           Boolean   @default(false)
  usageCount         Int       @default(0)
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  jobs               ReconJob[]

  @@index([tenantId])
  @@index([isPublic])
  @@map("mapping_templates")
}

model ValidationRule {
  id          String    @id @default(uuid())
  tenantId    String?   @db.Uuid
  name        String
  description String?
  ruleType    String
  ruleConfig  Json
  severity    String    @default("error")
  isActive    Boolean   @default(true)
  isPublic    Boolean   @default(false)
  isSystem    Boolean   @default(false)
  usageCount  Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([ruleType])
  @@index([isActive])
  @@index([isPublic])
  @@map("validation_rules")
}

model TransformRecipe {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  name              String
  description       String?
  recipeType        String
  inputSchema       Json
  outputSchema      Json
  transformationSteps Json    @default("[]")
  validationRules   Json      @default("[]")
  isPublic          Boolean   @default(false)
  isSystem          Boolean   @default(false)
  usageCount        Int       @default(0)
  version           Int       @default(1)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([recipeType])
  @@index([isPublic])
  @@map("transform_recipes")
}

model ContractVersion {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  contractName      String
  version           String
  schemaDefinition  Json
  isActive          Boolean   @default(true)
  isDeprecated      Boolean   @default(false)
  deprecatedAt      DateTime?
  breakingChanges   Json      @default("[]")
  migrationGuide    String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  driftEvents       DriftEvent[]

  @@unique([tenantId, contractName, version])
  @@index([tenantId])
  @@index([contractName])
  @@index([isActive])
  @@map("contract_versions")
}

model DriftEvent {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  reconJobId        String?   @db.Uuid
  contractVersionId String?   @db.Uuid
  driftType         String
  severity          String    @default("warning")
  fieldPath         String?
  expectedValue     Json?
  actualValue       Json?
  driftMetrics      Json      @default("{}")
  autoRepaired      Boolean   @default(false)
  repairAction      Json?
  acknowledged      Boolean   @default(false)
  acknowledgedBy    String?   @db.Uuid
  acknowledgedAt     DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  contractVersion   ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([driftType])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@index([acknowledged])
  @@map("drift_events")
}

model WorkflowRun {
  id            String    @id @default(uuid())
  tenantId      String    @db.Uuid
  workflowId    String
  workflowName  String?
  workflowVersion String?
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  triggeredBy   String?
  triggerEvent  Json?
  executionGraph Json?
  stepResults   Json      @default("{}")
  errorMessage  String?   @db.Text
  errorStack    String?   @db.Text
  durationMs    BigInt?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([workflowId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("workflow_runs")
}

// ============================================================================
// RECEIPTS API MODELS
// Receipt parsing and storage for Settler Receipts API
// ============================================================================

model ReceiptUpload {
  id                String    @id @default(uuid())
  apiKeyId          String?   @db.Uuid // Optional: can be created without API key for testing
  billingAccountId  String?   @db.Uuid // Optional: for usage tracking
  storageLocation   String    // URL or storage key
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  status            String    @default("pending") // pending, processing, completed, failed
  errorMessage      String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  receipt           Receipt?

  @@index([apiKeyId])
  @@index([billingAccountId])
  @@index([status])
  @@index([createdAt])
  @@map("receipt_uploads")
}

model Receipt {
  id                String    @id @default(uuid())
  uploadId           String    @db.Uuid @unique
  vendor             String?
  date               DateTime?
  currency           String?
  subtotal           Decimal?  @db.Decimal(15, 2)
  tax                Decimal?  @db.Decimal(15, 2)
  total              Decimal?  @db.Decimal(15, 2)
  paymentMethod      String?
  confidenceScore    Decimal?  @db.Decimal(5, 4) // 0.0000 to 1.0000
  rawText            String?   @db.Text
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  upload             ReceiptUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  items              ReceiptItem[]

  @@index([uploadId])
  @@index([vendor])
  @@index([date])
  @@index([createdAt])
  @@map("receipts")
}

model ReceiptItem {
  id                String    @id @default(uuid())
  receiptId         String    @db.Uuid
  name              String
  quantity          Decimal?  @db.Decimal(10, 3)
  unitPrice         Decimal?  @db.Decimal(15, 2)
  lineTotal         Decimal?  @db.Decimal(15, 2)
  category          String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  receipt           Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([category])
  @@map("receipt_items")
}

// ============================================================================
// FEATURE FLAGS API MODELS
// Feature flag management for Settler Feature Flags API (free developer toolkit)
// ============================================================================

model FeatureFlag {
  id                String    @id @default(uuid())
  billingAccountId  String?   @db.Uuid // Optional: for usage tracking
  projectId         String?   @db.Uuid // Optional: for project-scoped flags
  key               String    // e.g., "new-dashboard", "enable-beta-feature"
  name              String
  description       String?
  type              String    @default("boolean") // boolean, string, number
  isGlobal          Boolean   @default(false) // true if applies to all projects
  defaultValue      Json?     // Default value for the flag
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  environments      FeatureFlagEnvironment[]
  overrides         FeatureFlagOverride[]

  @@unique([billingAccountId, projectId, key])
  @@index([billingAccountId])
  @@index([projectId])
  @@index([key])
  @@index([isGlobal])
  @@index([deletedAt])
  @@map("feature_flags")
}

model FeatureFlagEnvironment {
  id                String    @id @default(uuid())
  flagId            String    @db.Uuid
  environment       String    // e.g., "production", "staging", "development"
  enabled           Boolean   @default(false)
  variant           Json?     // For string/number flags, the variant value
  config            Json      @default("{}") // Additional environment-specific config
  updatedAt         DateTime  @updatedAt
  updatedBy         String?   @db.Uuid

  flag              FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, environment])
  @@index([flagId])
  @@index([environment])
  @@index([enabled])
  @@map("feature_flag_environments")
}

model FeatureFlagOverride {
  id                String    @id @default(uuid())
  flagId            String    @db.Uuid
  environment       String
  targetKey         String    // userId, tenantId, or other identifier
  targetType        String    @default("user") // user, tenant, segment, etc.
  value             Json      // The override value
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?

  flag              FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, environment, targetKey, targetType])
  @@index([flagId])
  @@index([environment])
  @@index([targetKey])
  @@index([expiresAt])
  @@map("feature_flag_overrides")
}

// ============================================================================
// MULTI-TENANT & WHITE-LABEL SITE BUILDER MODELS
// Multi-tenant front-end configuration, page builder, and A/B testing
// ============================================================================

model Tenant {
  id                String    @id @default(uuid())
  billingAccountId  String?   @unique @db.Uuid // Optional: link to billing account
  slug               String    @unique // e.g., "default", "partner-x"
  primaryDomain      String?   // e.g., "settler.dev"
  customDomain       String?   // e.g., "api.partnerx.com"
  name               String
  isActive            Boolean   @default(true)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  billingAccount     BillingAccount? @relation(fields: [billingAccountId], references: [id], onDelete: SetNull)
  branding           TenantBranding?
  navigation         TenantNavigation?
  pages              TenantPage[]
  experiments        Experiment[]

  @@index([slug])
  @@index([primaryDomain])
  @@index([customDomain])
  @@index([billingAccountId])
  @@index([isActive])
  @@map("tenants")
}

model OnboardingProgress {
  id                String    @id @default(uuid())
  userId            String    @db.Uuid @unique
  currentStep       String    @default("welcome")
  completedSteps    String[]  @default([])
  skippedSteps      String[]  @default([])
  progress          Int       @default(0) // 0-100
  metadata          Json      @default("{}")
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([currentStep])
  @@index([progress])
  @@map("onboarding_progress")
}

model TenantOnboardingProgress {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  currentStep       String    @default("create_workspace")
  completedSteps    String[]  @default([])
  skippedSteps      String[]  @default([])
  progress          Int       @default(0) // 0-100
  metadata          Json      @default("{}")
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([progress])
  @@map("tenant_onboarding_progress")
}

model WorkspaceInvite {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  invitedBy         String    @db.Uuid
  email              String
  role               String    // owner, admin, member, viewer
  token              String    @unique
  status             String    @default("pending") // pending, accepted, expired, revoked
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedBy         String?   @db.Uuid
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("workspace_invites")
}

model OnboardingEvent {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  userId            String    @db.Uuid
  eventType         String    // onboarding_started, step_completed, activation_complete
  stepId            String?
  traceId           String?
  properties        Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([eventType])
  @@index([traceId])
  @@index([createdAt(sort: Desc)])
  @@map("onboarding_events")
}

model AuditLog {
  id                String    @id @default(uuid())
  userId            String?   @db.Uuid
  billingAccountId  String?   @db.Uuid
  tenantId          String?   @db.Uuid
  action            String    // 'create', 'update', 'delete', 'read', etc.
  resourceType      String    // 'api_key', 'receipt', 'feature_flag', etc.
  resourceId        String?   @db.Uuid
  changes           Json?     // Before/after state
  ipAddress         String?
  userAgent         String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([billingAccountId])
  @@index([tenantId])
  @@index([resourceType])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model TenantBranding {
  id                String    @id @default(uuid())
  tenantId           String    @db.Uuid @unique
  logoUrl            String?
  faviconUrl         String?
  primaryColor       String    @default("#2563eb")
  secondaryColor     String    @default("#7c3aed")
  accentColor        String    @default("#06b6d4")
  backgroundColor    String    @default("#ffffff")
  borderRadiusScale   Decimal?  @db.Decimal(3, 2) // e.g., 0.5, 1.0, 1.5
  fontFamilyPrimary   String?   // Selected from safe set
  fontFamilySecondary String?
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_branding")
}

model TenantNavigation {
  id                String    @id @default(uuid())
  tenantId           String    @db.Uuid @unique
  navItems           Json      @default("[]") // Structured list of nav items
  footerItems        Json      @default("[]") // Structured list of footer items
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_navigation")
}

model TenantPage {
  id                String    @id @default(uuid())
  tenantId           String    @db.Uuid
  slug               String    // e.g., "" for homepage, "pricing", "docs/overview"
  pageType           String    // "marketing" | "docs" | "landing" | "custom"
  schemaVersion      String    @default("1.0")
  blocks             Json      @default("[]") // Ordered list of content blocks/sections
  seoTitle           String?
  seoDescription     String?
  seoImageUrl        String?
  isDraft            Boolean   @default(false)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revisions          TenantPageRevision[]
  experiments        Experiment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([slug])
  @@index([pageType])
  @@index([isDraft])
  @@map("tenant_pages")
}

model TenantPageRevision {
  id                String    @id @default(uuid())
  tenantPageId       String    @db.Uuid
  editorUserId       String?   @db.Uuid
  snapshot           Json      // Full copy of blocks and optionally SEO fields
  comment            String?
  approvedByUserId   String?   @db.Uuid
  approvedAt          DateTime?
  createdAt          DateTime  @default(now())

  tenantPage         TenantPage @relation(fields: [tenantPageId], references: [id], onDelete: Cascade)

  @@index([tenantPageId])
  @@index([editorUserId])
  @@index([approvedByUserId])
  @@index([createdAt(sort: Desc)])
  @@map("tenant_page_revisions")
}

// ============================================================================
// A/B TESTING & EXPERIMENTS MODELS
// Experiment management and metrics tracking for site builder
// ============================================================================

model Experiment {
  id                String    @id @default(uuid())
  tenantId           String    @db.Uuid
  targetPageId       String    @db.Uuid
  name               String
  slug               String
  status             String    @default("draft") // "draft" | "running" | "paused" | "completed"
  trafficSplit       Json      @default("{}") // Mapping variantKey → percentage
  primaryMetric      String    @default("click_through") // "click_through" | "signup" | "conversion" | "custom"
  startsAt           DateTime?
  endsAt             DateTime?
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetPage         TenantPage @relation(fields: [targetPageId], references: [id], onDelete: Cascade)
  variants           ExperimentVariant[]
  metricEvents       ExperimentMetricEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([targetPageId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("experiments")
}

model ExperimentVariant {
  id                String    @id @default(uuid())
  experimentId       String    @db.Uuid
  key                String    // e.g., "A", "B", "control", "variant-1"
  label              String    // e.g., "Control", "New Hero"
  blocksOverride     Json      @default("{}") // Partial or full overrides for TenantPage.blocks
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  experiment         Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, key])
  @@index([experimentId])
  @@index([key])
  @@map("experiment_variants")
}

model ExperimentMetricEvent {
  id                String    @id @default(uuid())
  experimentId       String    @db.Uuid
  variantKey         String
  tenantId           String    @db.Uuid
  pageId             String    @db.Uuid
  eventType          String    // "view" | "click" | "conversion" | "custom"
  sessionId          String?
  userId             String?   @db.Uuid
  meta               Json      @default("{}")
  createdAt          DateTime  @default(now())

  experiment         Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([variantKey])
  @@index([tenantId])
  @@index([pageId])
  @@index([eventType])
  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@map("experiment_metric_events")
}

// ============================================================================
// WEBHOOK MODELS
// Webhook configuration and delivery tracking
// ============================================================================

model Webhook {
  id                String    @id @default(uuid())
  userId            String    @db.Uuid
  tenantId          String    @db.Uuid
  url               String    @db.Text
  events            Json      @default("[]") // Array of event type strings
  secret            String    @db.Text // HMAC signing secret
  status            String    @default("active") // active, inactive, deleted
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  deliveries        WebhookDelivery[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id                String    @id @default(uuid())
  webhookId         String    @db.Uuid
  url               String    @db.Text
  payload           Json      // The webhook event payload
  status            String    @default("pending") // pending, delivered, failed
  statusCode        Int?
  responseBody      String?   @db.Text
  attempts          Int       @default(1)
  nextRetryAt       DateTime?
  errorMessage      String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  webhook           Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ============================================================================
// IDEMPOTENCY MODELS
// Request idempotency for safe retries
// ============================================================================

model IdempotencyKey {
  id                String    @id @default(uuid())
  key               String    @unique // The idempotency key
  status            String    @default("pending") // pending, completed, failed
  response          Json?     // Cached response for completed requests
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  expiresAt         DateTime  // Auto-cleanup after 24 hours

  @@index([key])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// INGESTION PIPELINE MODELS
// Universal ingestion system for connectors and imports
// ============================================================================

model IngestionSource {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  name              String
  type              String    // "csv", "stripe", "shopify", "manual", etc.
  connectorType     String?   // "stripe", "shopify", etc. (null for CSV/manual)
  configEncrypted   String?   @db.Text // Encrypted connector config (API keys, OAuth tokens)
  configMetadata    Json      @default("{}") // Non-sensitive metadata (connector name, etc.)
  status            String    @default("active") // active, paused, error
  lastSyncAt        DateTime?
  lastSyncStatus    String?   // success, failed, partial
  lastSyncError     String?   @db.Text
  syncSchedule      String?   // Cron expression for scheduled syncs
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  ingestions        Ingestion[]
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([connectorType])
  @@index([status])
  @@index([deletedAt])
  @@map("ingestion_sources")
}

model Ingestion {
  id                String    @id @default(uuid())
  sourceId          String    @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  idempotencyKey    String?   @unique // For idempotent retries
  status            String    @default("pending") // pending, processing, completed, failed
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  errorMessage      String?   @db.Text
  errorStack        String?   @db.Text
  traceId           String?   // For observability
  rawRecordCount    Int       @default(0)
  normalizedCount   Int       @default(0)
  failedCount       Int       @default(0)
  retryCount        Int       @default(0)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]
  reconciliationRuns ReconciliationRun[]

  @@index([sourceId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([startedAt(sort: Desc)])
  @@map("ingestions")
}

model RawRecord {
  id                String    @id @default(uuid())
  ingestionId       String    @db.Uuid
  sourceId          String    @db.Uuid
  tenantId          String    @db.Uuid
  rawData           Json      // Original raw data from source
  rowNumber         Int?      // For CSV imports
  externalId        String?   // External ID from source system
  status            String    @default("pending") // pending, normalized, failed
  errorMessage      String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  normalizedTransaction NormalizedTransaction?

  @@index([ingestionId])
  @@index([sourceId])
  @@index([tenantId])
  @@index([externalId])
  @@index([status])
  @@map("raw_records")
}

model NormalizedTransaction {
  id                String    @id @default(uuid())
  ingestionId       String    @db.Uuid
  rawRecordId       String?   @db.Uuid @unique
  tenantId          String    @db.Uuid
  sourceId          String    @db.Uuid
  externalId        String?   // External ID from source system
  amount            Decimal   @db.Decimal(15, 2)
  currency          String    @default("USD")
  date              DateTime  @db.Date
  description       String?   @db.Text
  category          String?
  paymentMethod     String?
  reference         String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  rawRecord         RawRecord? @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  reconciliationMatches ReconciliationMatch[]

  @@index([ingestionId])
  @@index([rawRecordId])
  @@index([tenantId])
  @@index([sourceId])
  @@index([externalId])
  @@index([date])
  @@index([amount])
  @@index([currency])
  @@index([tenantId, date, amount, currency])
  @@map("normalized_transactions")
}

model ReconciliationRun {
  id                String    @id @default(uuid())
  ingestionId       String?   @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  name              String?
  status            String    @default("pending") // pending, running, completed, failed
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  sourceCount       Int       @default(0)
  targetCount       Int       @default(0)
  matchedCount      Int       @default(0)
  unmatchedSourceCount Int    @default(0)
  unmatchedTargetCount Int    @default(0)
  confidenceAvg     Decimal?  @db.Decimal(5, 4)
  errorMessage      String?   @db.Text
  traceId           String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ingestion         Ingestion? @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  matches           ReconciliationMatch[]

  @@index([ingestionId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("reconciliation_runs")
}

model ReconciliationMatch {
  id                String    @id @default(uuid())
  runId             String    @db.Uuid
  sourceTransactionId String  @db.Uuid
  targetTransactionId String?  @db.Uuid
  tenantId          String    @db.Uuid
  matchType         String    // "exact", "fuzzy", "manual", "unmatched"
  confidence        Decimal   @db.Decimal(5, 4) // 0.0000 to 1.0000
  matchReason       String?   @db.Text
  amountDiff        Decimal?  @db.Decimal(15, 2)
  dateDiff          Int?      // Days difference
  reviewed          Boolean   @default(false)
  reviewedBy        String?   @db.Uuid
  reviewedAt        DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  run               ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceTransaction NormalizedTransaction @relation(fields: [sourceTransactionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([tenantId])
  @@index([sourceTransactionId])
  @@index([targetTransactionId])
  @@index([matchType])
  @@index([confidence])
  @@index([reviewed])
  @@map("reconciliation_matches")
}

model Export {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  type              String    // "csv", "json", "excel"
  format            String    // "matched", "unmatched", "all", "reconciliation_report"
  reconciliationRunId String?  @db.Uuid
  ingestionId       String?   @db.Uuid
  status            String    @default("pending") // pending, processing, completed, failed
  storageLocation   String?   // URL or storage key
  signedUrl         String?   @db.Text
  signedUrlExpiresAt DateTime?
  fileSizeBytes     Int?
  rowCount           Int?
  errorMessage      String?   @db.Text
  traceId           String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime? // Auto-cleanup after expiration

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([reconciliationRunId])
  @@index([ingestionId])
  @@index([createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("exports")
}
