  metadata          Json       @default("{}")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([tenantId, artifactKey])
  @@index([tenantId])
  @@index([artifactType])
  @@index([runId])
  @@index([exceptionId])
  @@index([capturedAt(sort: Desc)])
  @@index([isExpired])
  @@map("evidence_artifacts")
}

