model OnboardingEvent {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  userId            String    @db.Uuid
  eventType         String    // onboarding_started, step_completed, activation_complete
  stepId            String?
  traceId           String?
  properties        Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([eventType])
  @@index([traceId])
  @@index([createdAt(sort: Desc)])
  @@map("onboarding_events")
}

model AuditLog {
  id                String    @id @default(uuid())
  userId            String?   @db.Uuid
  billingAccountId  String?   @db.Uuid
  tenantId          String?   @db.Uuid
  action            String    // 'create', 'update', 'delete', 'read', etc.
  resourceType      String    // 'api_key', 'receipt', 'feature_flag', etc.
  resourceId        String?   @db.Uuid
  changes           Json?     // Before/after state
  ipAddress         String?
  userAgent         String?   @db.Text
  metadata          Json      @default("{}")
  
  // Enhanced mutation traceability fields
  traceId           String?   @db.Uuid // For distributed tracing correlation
  requestId         String?   // Request ID for correlation
  sessionId         String?   @db.Uuid // Session tracking
  actorType         String?   // 'user', 'system', 'worker', 'scheduler', 'api_key'
  actorId           String?   @db.Uuid // ID of the actor performing the action
  reason            String?   @db.VarChar(500) // Reason for the action (for governance)
  
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([billingAccountId])
  @@index([tenantId])
  @@index([resourceType])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([actorType, action])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@map("audit_logs")
}


// ============================================================================
// WEBHOOK MODELS
// Webhook configuration and delivery tracking
// ============================================================================

model Webhook {
  id                String    @id @default(uuid())
  userId            String    @db.Uuid
  tenantId          String    @db.Uuid
  url               String    @db.Text
  events            Json      @default("[]") // Array of event type strings
  secret            String    @db.Text // HMAC signing secret
  status            String    @default("active") // active, inactive, deleted
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  deliveries        WebhookDelivery[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id                String    @id @default(uuid())
  webhookId         String    @db.Uuid
  url               String    @db.Text
  payload           Json      // The webhook event payload
  status            String    @default("pending") // pending, delivered, failed
  statusCode        Int?
  responseBody      String?   @db.Text
  attempts          Int       @default(1)
  nextRetryAt       DateTime?
  errorMessage      String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  webhook           Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ============================================================================
// IDEMPOTENCY MODELS
// Request idempotency for safe retries
// ============================================================================

model IdempotencyKey {
  id                String    @id @default(uuid())
  key               String    @unique // The idempotency key
  status            String    @default("pending") // pending, completed, failed
  response          Json?     // Cached response for completed requests
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  expiresAt         DateTime  // Auto-cleanup after 24 hours

  @@index([key])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// INGESTION PIPELINE MODELS
// Universal ingestion system for connectors and imports
// ============================================================================

model IngestionSource {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  name              String
  type              String    // "csv", "stripe", "shopify", "manual", etc.
  connectorType     String?   // "stripe", "shopify", etc. (null for CSV/manual)
  configEncrypted   String?   @db.Text // Encrypted connector config (API keys, OAuth tokens)
  configMetadata    Json      @default("{}") // Non-sensitive metadata (connector name, etc.)
  status            String    @default("active") // active, paused, error
  lastSyncAt        DateTime?
  lastSyncStatus    String?   // success, failed, partial
  lastSyncError     String?   @db.Text
  syncSchedule      String?   // Cron expression for scheduled syncs
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  ingestions        Ingestion[]
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([connectorType])
  @@index([status])
  @@index([deletedAt])
  @@map("ingestion_sources")
}

model Ingestion {
  id                String    @id @default(uuid())
  sourceId          String    @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  idempotencyKey    String?   @unique // For idempotent retries
  status            String    @default("pending") // pending, processing, completed, failed
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  errorMessage      String?   @db.Text
  errorStack        String?   @db.Text
  traceId           String?   // For observability
  rawRecordCount    Int       @default(0)
  normalizedCount   Int       @default(0)
  failedCount       Int       @default(0)
  retryCount        Int       @default(0)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]
  reconciliationRuns ReconciliationRun[]

  @@index([sourceId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([startedAt(sort: Desc)])
  @@map("ingestions")
}

model RawRecord {
  id                String    @id @default(uuid())
  ingestionId       String    @db.Uuid
  sourceId          String    @db.Uuid
  tenantId          String    @db.Uuid
  rawData           Json      // Original raw data from source
  rowNumber         Int?      // For CSV imports
  externalId        String?   // External ID from source system
  status            String    @default("pending") // pending, normalized, failed
  errorMessage      String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  normalizedTransaction NormalizedTransaction?

  @@index([ingestionId])
  @@index([sourceId])
  @@index([tenantId])
  @@index([externalId])
  @@index([status])
  @@map("raw_records")
}

model NormalizedTransaction {
  id                String    @id @default(uuid())
  ingestionId       String    @db.Uuid
  rawRecordId       String?   @db.Uuid @unique
  tenantId          String    @db.Uuid
  sourceId          String    @db.Uuid
  externalId        String?   // External ID from source system
  amount            Decimal   @db.Decimal(15, 2)
  currency          String    @default("USD")
  date              DateTime  @db.Date
  description       String?   @db.Text
  category          String?
  paymentMethod     String?
  reference         String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  rawRecord         RawRecord? @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  reconciliationMatches ReconciliationMatch[]

  @@index([ingestionId])
  @@index([rawRecordId])
  @@index([tenantId])
  @@index([sourceId])
  @@index([externalId])
  @@index([date])
  @@index([amount])
  @@index([currency])
  @@index([tenantId, date, amount, currency])
  @@map("normalized_transactions")
}

model ReconciliationRun {
  id                String    @id @default(uuid())
  ingestionId       String?   @map("ingestion_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  name              String?
  status            String    @default("pending") // pending, running, completed, failed
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  sourceCount       Int       @default(0) @map("source_count")
  targetCount       Int       @default(0) @map("target_count")
  matchedCount      Int       @default(0) @map("matched_count")
  unmatchedSourceCount Int    @default(0) @map("unmatched_source_count")
  unmatchedTargetCount Int    @default(0) @map("unmatched_target_count")
  confidenceAvg     Decimal?  @map("confidence_avg") @db.Decimal(5, 4)
  errorMessage      String?   @map("error_message") @db.Text
  traceId           String?   @map("trace_id")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  ingestion         Ingestion? @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  matches           ReconciliationMatch[]

  @@index([ingestionId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("reconciliation_runs")
}

model ReconciliationMatch {
  id                String    @id @default(uuid())
  runId             String    @db.Uuid
  sourceTransactionId String  @db.Uuid
  targetTransactionId String?  @db.Uuid
  tenantId          String    @db.Uuid
  matchType         String    // "exact", "fuzzy", "manual", "unmatched"
  confidence        Decimal   @db.Decimal(5, 4) // 0.0000 to 1.0000
  matchReason       String?   @db.Text
  amountDiff        Decimal?  @db.Decimal(15, 2)
  dateDiff          Int?      // Days difference
  reviewed          Boolean   @default(false)
  reviewedBy        String?   @db.Uuid
  reviewedAt        DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  run               ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceTransaction NormalizedTransaction @relation(fields: [sourceTransactionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([tenantId])
  @@index([sourceTransactionId])
  @@index([targetTransactionId])
  @@index([matchType])
  @@index([confidence])
  @@index([reviewed])
  @@map("reconciliation_matches")
}

model Export {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  type              String    // "csv", "json", "excel"
  format            String    // "matched", "unmatched", "all", "reconciliation_report"
  reconciliationRunId String?  @db.Uuid
  ingestionId       String?   @db.Uuid
  status            String    @default("pending") // pending, processing, completed, failed
  storageLocation   String?   // URL or storage key
  signedUrl         String?   @db.Text
  signedUrlExpiresAt DateTime?
  fileSizeBytes     Int?
  rowCount           Int?
  errorMessage      String?   @db.Text
  traceId           String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime? // Auto-cleanup after expiration

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([reconciliationRunId])
  @@index([ingestionId])
  @@index([createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("exports")
}

// ============================================================================
// RETENTION AUTOMATION MODELS
// ============================================================================

model RetentionMetric {
  id              String    @id @default(uuid())
  tenantId        String?   @db.Uuid
  prunedCount     Int       @default(0)
  storageBytes    BigInt    @default(0)
  violations      Int       @default(0)
  latencyMs       BigInt    @default(0)
  runDate         DateTime  @db.Date @default(now())
  createdAt       DateTime  @default(now())

  @@unique([tenantId, runDate])
  @@index([tenantId])
  @@index([runDate(sort: Desc)])
  @@map("retention_metrics")
}
