  tenantId          String?   @db.Uuid @map("tenant_id")
  action            String     @map("action") // 'create', 'update', 'delete', 'read', etc.
  resourceType      String     @map("resource_type") // 'api_key', 'receipt', 'feature_flag', etc.
  resourceId        String?   @db.Uuid @map("resource_id")
  changes           Json?      @map("changes") // Before/after state
  ipAddress         String? @map("ip_address")
  userAgent         String?   @db.Text @map("user_agent")
  metadata          Json      @default("{}")
  
  // Enhanced mutation traceability fields
  traceId           String?   @db.Uuid  @map("trace_id") // For distributed tracing correlation
  requestId         String?    @map("request_id") // Request ID for correlation
  sessionId         String?   @db.Uuid  @map("session_id") // Session tracking
  actorType         String?    @map("actor_type") // 'user', 'system', 'worker', 'scheduler', 'api_key'
  actorId           String?   @db.Uuid  @map("actor_id") // ID of the actor performing the action
  reason            String?   @db.VarChar(500)  @map("reason") // Reason for the action (for governance)
  
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([billingAccountId])
  @@index([tenantId])
  @@index([resourceType])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([actorType, action])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@map("audit_logs")
}


// ============================================================================
// WEBHOOK MODELS
// Webhook configuration and delivery tracking
// ============================================================================

model Webhook {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid @map("user_id")
  tenantId          String    @db.Uuid @map("tenant_id")
  url               String @db.VarChar
  events            Json      @default("[]") // Array of event type strings
  secret            String @db.VarChar  // HMAC signing secret
  status            String    @default("active") // active, inactive, deleted
  metadata          Json      @default("{}") @map("metadata")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  deliveries        WebhookDelivery[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  webhookId         String    @db.Uuid @map("webhook_id")
  url               String @db.VarChar
  payload           Json      // The webhook event payload
  status            String    @default("pending") // pending, delivered, failed
  statusCode        Int? @map("status_code")
  responseBody      String?   @db.Text @map("response_body")
  attempts          Int       @default(1)
  nextRetryAt       DateTime? @map("next_retry_at") @db.Timestamptz
  errorMessage      String?   @db.Text @map("error_message")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  webhook           Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ============================================================================
// IDEMPOTENCY MODELS
// Request idempotency for safe retries
// ============================================================================

model IdempotencyKey {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  key               String    // The idempotency key
  status            String    @default("pending") // pending, completed, failed
  response          Json?     // Cached response for completed requests
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz  // Auto-cleanup after 24 hours

  @@unique([tenantId, key], map: "idempotency_keys_tenant_key_unique")
  @@index([tenantId, userId])
  @@index([tenantId, key])
  @@index([key])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// INGESTION PIPELINE MODELS
// Universal ingestion system for connectors and imports
// ============================================================================

model IngestionSource {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  userId            String    @db.Uuid @map("user_id")
  name              String
  type              String    // "csv", "stripe", "shopify", "manual", etc.
  connectorType     String?    @map("connector_type") // "stripe", "shopify", etc. (null for CSV/manual)
  configEncrypted   String?   @db.Text  @map("config_encrypted") // Encrypted connector config (API keys, OAuth tokens)
  configMetadata    Json      @default("{}")  @map("config_metadata") // Non-sensitive metadata (connector name, etc.)
  status            String    @default("active") // active, paused, error
  lastSyncAt        DateTime? @map("last_sync_at") @db.Timestamptz
  lastSyncStatus    String?    @map("last_sync_status") // success, failed, partial
  lastSyncError     String?   @db.Text @map("last_sync_error")
  syncSchedule      String?    @map("sync_schedule") // Cron expression for scheduled syncs
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  ingestions        Ingestion[]
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([connectorType])
  @@index([status])
  @@index([deletedAt])
  @@map("ingestion_sources")
}

model Ingestion {
  id                String    @id @default(uuid()) @db.Uuid
  sourceId          String    @db.Uuid @map("source_id")
  tenantId          String    @db.Uuid @map("tenant_id")
  userId            String    @db.Uuid @map("user_id")
  idempotencyKey    String?   @unique  @map("idempotency_key") // For idempotent retries
  status            String    @default("pending") // pending, processing, completed, failed
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  errorMessage      String?   @db.Text @map("error_message")
  errorStack        String?   @db.Text @map("error_stack")
  traceId           String?    @map("trace_id") // For observability
  rawRecordCount    Int       @default(0) @map("raw_record_count")
  normalizedCount   Int       @default(0) @map("normalized_count")
  failedCount       Int       @default(0) @map("failed_count")
  retryCount        Int       @default(0) @map("retry_count")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]
  reconciliationRuns ReconciliationRun[]

  @@index([sourceId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([startedAt(sort: Desc)])
  @@map("ingestions")
}

model RawRecord {
  id                String    @id @default(uuid()) @db.Uuid
  ingestionId       String    @db.Uuid @map("ingestion_id")
  sourceId          String    @db.Uuid @map("source_id")
  tenantId          String    @db.Uuid @map("tenant_id")
  rawData           Json       @map("raw_data") // Original raw data from source
  rowNumber         Int?       @map("row_number") // For CSV imports
  externalId        String?    @map("external_id") // External ID from source system
  status            String    @default("pending") // pending, normalized, failed
  errorMessage      String?   @db.Text @map("error_message")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  normalizedTransaction NormalizedTransaction?

  @@index([ingestionId])
  @@index([sourceId])
  @@index([tenantId])
  @@index([externalId])
  @@index([status])
  @@map("raw_records")
}

model NormalizedTransaction {
  id                String    @id @default(uuid()) @db.Uuid
  ingestionId       String    @db.Uuid @map("ingestion_id")
  rawRecordId       String?   @db.Uuid @unique @map("raw_record_id")
  tenantId          String    @db.Uuid @map("tenant_id")
  sourceId          String    @db.Uuid @map("source_id")
  externalId        String?    @map("external_id") // External ID from source system
  amount            Decimal   @db.Decimal(15, 2)
  currency          String    @default("USD")
  date              DateTime  @db.Date
  description       String?   @db.Text
  category          String?
  paymentMethod     String? @map("payment_method")
  reference         String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  rawRecord         RawRecord? @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceMatches         ReconciliationMatch[] @relation("SourceMatches")
  targetMatches         ReconciliationMatch[] @relation("TargetMatches")

  @@index([ingestionId])
  @@index([rawRecordId])
  @@index([tenantId])
  @@index([sourceId])
  @@index([externalId])
  @@index([date])
  @@index([amount])
  @@index([currency])
  @@index([tenantId, date, amount, currency])
  @@map("normalized_transactions")
}

model ReconciliationRun {
  id                String    @id @default(uuid()) @db.Uuid
  ingestionId       String?   @map("ingestion_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  name              String?
  status            String    @default("pending") // pending, running, completed, failed
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  sourceCount       Int       @default(0) @map("source_count")
  targetCount       Int       @default(0) @map("target_count")
  matchedCount      Int       @default(0) @map("matched_count")
  unmatchedSourceCount Int    @default(0) @map("unmatched_source_count")
  unmatchedTargetCount Int    @default(0) @map("unmatched_target_count")
  confidenceAvg     Decimal?  @map("confidence_avg") @db.Decimal(5, 4)
  errorMessage      String?   @map("error_message") @db.Text
  traceId           String?   @map("trace_id")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  ingestion         Ingestion? @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  matches           ReconciliationMatch[]
  provenance        ReconciliationProvenance[]

  @@index([ingestionId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("reconciliation_runs")
}

model ReconciliationMatch {
  id                String    @id @default(uuid()) @db.Uuid
  runId             String    @db.Uuid @map("run_id")
  sourceTransactionId String  @db.Uuid @map("source_transaction_id")
  targetTransactionId String?  @db.Uuid @map("target_transaction_id")
  tenantId          String    @db.Uuid @map("tenant_id")
  matchType         String     @map("match_type") // "exact", "fuzzy", "manual", "unmatched"
  confidence        Decimal   @db.Decimal(5, 4) // 0.0000 to 1.0000
  matchReason       String?   @db.Text @map("match_reason")
  amountDiff        Decimal?  @db.Decimal(15, 2) @map("amount_diff")
  dateDiff          Int?       @map("date_diff") // Days difference
  reviewed          Boolean   @default(false)
  reviewedBy        String?   @db.Uuid @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  // Enterprise exception workflow fields
  status            String    @default("open")  @map("status") // open, in_progress, resolved, dismissed
  assignedTo        String?   @db.Uuid  @map("assigned_to") // Operator assigned to resolve this exception
  resolutionReason  String?   @db.VarChar(100)  @map("resolution_reason") // Structured reason for resolution
  notes             String?   @db.Text  @map("notes") // Operator notes during adjudication
  severity          String    @default("medium")  @map("severity") // low, medium, high, critical
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  run               ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceTransaction NormalizedTransaction @relation("SourceMatches", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  targetTransaction NormalizedTransaction? @relation("TargetMatches", fields: [targetTransactionId], references: [id], onDelete: SetNull)
  provenance        ReconciliationProvenance[]
  adjudicationMemories ExceptionAdjudicationMemory[]
  archetypeClassifications ExceptionArchetypeClassification[]

  @@index([runId])
  @@index([tenantId])
  @@index([sourceTransactionId])
  @@index([targetTransactionId])
  @@index([matchType])
  @@index([confidence])
  @@index([reviewed])
  @@index([tenantId, status, assignedTo])
  @@index([tenantId, status, severity])
  @@map("reconciliation_matches")
}



model ReconciliationProvenance {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  runId             String   @map("run_id") @db.Uuid
  matchId           String?  @map("match_id") @db.Uuid
  sequence          Int
  eventType         String   @map("event_type")
  actorType         String   @default("system") @map("actor_type")
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  details           Json     @default("{}")
  entryHash         String   @map("entry_hash")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  run               ReconciliationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  match             ReconciliationMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([runId, sequence])
  @@index([tenantId])
  @@index([runId])
  @@index([matchId])
  @@index([eventType])
  @@index([createdAt])
  @@map("reconciliation_provenance")
}

// ============================================================================
// EXCEPTION ONTOLOGY & ADJUDICATION MEMORY MODELS
// Phase II: Reconciliation-Intelligence primitives for compounding knowledge
// ============================================================================

model ExceptionArchetype {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  code              String    // e.g., "AMOUNT_MISMATCH", "DATE_DRIFT", "MISSING_IN_SOURCE"
  label             String    // Human-readable label
  description       String?   @db.Text
  category          String    // "amount", "timing", "missing", "duplicate", "classification"
  severityDefault   String    @default("medium")  @map("severity_default") // default severity for this archetype
  typicalResolution String?    @map("typical_resolution") // Common resolution for this archetype type
  resolutionTaxonomy Json     @default("[]")  @map("resolution_taxonomy") // Allowed resolutions for this archetype
  matchPattern      Json?      @map("match_pattern") // JSON pattern for auto-classification hints
  matchFieldWeights Json?     @default("{}")  @map("match_field_weights") // Weights for field-based matching
  isActive          Boolean   @default(true) @map("is_active")
  isSystem          Boolean   @default(false)  @map("is_system") // System-defined archetypes cannot be deleted
  occurrenceCount   Int       @default(0)  @map("occurrence_count") // Running count for prioritization
  lastOccurrenceAt  DateTime? @map("last_occurrence_at")
  metadata          Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  adjudicationMemories ExceptionAdjudicationMemory[]
  archetypeClassifications ExceptionArchetypeClassification[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
  @@index([occurrenceCount(sort: Desc)])
  @@map("exception_archetypes")
}

model ExceptionArchetypeClassification {
  id                String    @id @default(uuid()) @db.Uuid
  exceptionId       String    @db.Uuid  @map("exception_id") // FK to ReconciliationMatch.id
  archetypeId       String    @db.Uuid  @map("archetype_id") // FK to ExceptionArchetype.id
  tenantId          String    @db.Uuid @map("tenant_id")
  confidence        Decimal   @db.Decimal(5, 4) // Classification confidence score
  matchFeatures     Json      @default("{}")  @map("match_features") // Which features triggered this classification
  classifiedAt      DateTime  @default(now()) @map("classified_at")
  classifiedBy      String    @default("system")  @map("classified_by") // "system", "human", "ml"
  metadata          Json      @default("{}")

  exception         ReconciliationMatch @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  archetype        ExceptionArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)

  @@unique([exceptionId, archetypeId])
  @@index([exceptionId])
  @@index([archetypeId])
  @@index([tenantId])
  @@index([confidence])
  @@index([classifiedAt])
  @@map("exception_archetype_classifications")
}

model ExceptionAdjudicationMemory {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  exceptionId       String    @db.Uuid  @map("exception_id") // FK to ReconciliationMatch.id
  archetypeId       String?   @db.Uuid  @map("archetype_id") // FK to ExceptionArchetype.id (optional - can be classified later)
  
  // Structured resolution capture
  resolution        String    // matched, manual, ignored, duplicate, escalated
  resolutionReason String?    @map("resolution_reason") // Specific reason within the resolution category
  resolutionCode   String?    @map("resolution_code") // Machine-readable resolution code
  
  // Actor tracking
  adjudicatorId     String    @db.Uuid @map("adjudicator_id")
  adjudicatorType   String    @default("operator")  @map("adjudicator_type") // operator, supervisor, system, automated_rule
  adjudicationType   String    @default("initial")  @map("adjudication_type") // initial, re_adjudication, escalated_review, auto_resolved
  
  // Temporal tracking
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  durationMs       BigInt?    @map("duration_ms") // Time spent on adjudication
  
  // Outcome tracking
  outcome           String?   // resolved, escalated, reopened, confirmed_dismissed
  confidence        Decimal?  @db.Decimal(5, 4) // Confidence in the resolution
  reversibility     String?   // reversible, irreversible, pending_reversal
  
  // Lineage for reopen/escalation
  parentMemoryId    String?   @db.Uuid  @map("parent_memory_id") // Previous adjudication if reopened/escalated
  escalatedTo       String?    @map("escalated_to") // Queue or user escalated to
  escalationReason  String?   @db.Text @map("escalation_reason")
  
  // Evidence references
  evidenceIds       Json      @default("[]")  @map("evidence_ids") // Array of evidence artifact IDs used
  sourceTrustScore  Decimal?  @db.Decimal(5, 4)  @map("source_trust_score") // Trust score for source data
  
  // Annotations and context
  annotations       Json      @default("{}") // Structured key-value annotations
  operatorNotes     String?   @db.Text  @map("operator_notes") // Freeform operator notes
  systemNotes       String?   @db.Text  @map("system_notes") // System-generated notes (why flagged, suggestions)
  
  // Policy tuning signals
  suggestedPolicyChange Json?  @map("suggested_policy_change") // Hint for policy improvement
  policyChangeAccepted   Boolean?  @map("policy_change_accepted") // Whether suggestion was implemented
  
  // Provenance chain
  entryHash         String     @map("entry_hash") // Hash for audit chain integrity
  metadata          Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  exception         ReconciliationMatch @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  archetype         ExceptionArchetype? @relation(fields: [archetypeId], references: [id], onDelete: SetNull)
  parentMemory      ExceptionAdjudicationMemory? @relation("AdjudicationChain", fields: [parentMemoryId], references: [id], onDelete: SetNull)
  childMemories     ExceptionAdjudicationMemory[] @relation("AdjudicationChain")

  @@index([tenantId])
  @@index([exceptionId])
  @@index([archetypeId])
  @@index([adjudicatorId])
  @@index([resolution])
  @@index([outcome])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId, resolution, createdAt(sort: Desc)])
  @@map("exception_adjudication_memory")
}

// ============================================================================
// QUEUE WORKBENCH MODELS
// Saved views, SLA config, and queue intelligence
// ============================================================================

model QueueWorkbenchView {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  userId            String?   @db.Uuid  @map("user_id") // Null for shared tenant views
  name              String    // e.g., "Critical Exceptions", "My Queue"
  description       String?   @db.Text
  viewType          String    @default("personal")  @map("view_type") // personal, shared, system
  
  // Filter configuration (stored as structured JSON for reusability)
  filters           Json      @default("{}")
  sortConfig        Json      @default("{}") @map("sort_config")
  columnConfig      Json      @default("[]") @map("column_config")
  groupBy           String?    @map("group_by") // How to group results
  
  // Scope
  scope             String    @default("all") // all, job, severity, archetype
  scopeFilters      Json      @default("{}")  @map("scope_filters") // Specific scope filters
  
  // Display preferences
  refreshInterval   Int?       @map("refresh_interval") // Auto-refresh in seconds
  highlightRules   Json      @default("[]")  @map("highlight_rules") // Conditional formatting rules
  
  // Usage tracking
  usageCount        Int       @default(0) @map("usage_count")
  lastUsedAt       DateTime? @map("last_used_at")
  isDefault         Boolean   @default(false) @map("is_default")
  isFavorite        Boolean   @default(false) @map("is_favorite")
  
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([userId])
  @@index([scope])
  @@index([isDefault])
  @@index([isFavorite])
  @@map("queue_workbench_views")
}

model QueueSlaConfig {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  name              String    // e.g., "Standard SLA", "Critical Path SLA"
  description        String?   @db.Text
  
  // SLA definitions by severity/archetype
  slaConfig         Json       @map("sla_config") // { "critical": 3600, "high": 14400, "medium": 86400, "low": 259200 }
  escalationTimers  Json      @default("{}")  @map("escalation_timers") // When to escalate
  
  // Business hours (optional)
  businessHoursOnly  Boolean   @default(false) @map("business_hours_only")
  businessHours     Json?      @map("business_hours") // { "start": "09:00", "end": "17:00", "timezone": "America/New_York", "days": [1,2,3,4,5] }
  
  // Scope
  appliesTo         String    @default("all")  @map("applies_to") // all, specific_jobs, specific_archetypes
  scopeFilter       Json      @default("{}") @map("scope_filter")
  
  // Breaches
  autoEscalateOnBreach Boolean @default(true) @map("auto_escalate_on_breach")
  escalationTarget    String?   @map("escalation_target") // User ID or role to escalate to
