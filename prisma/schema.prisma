  delegateId        String    @db.Uuid // Person delegated to
  role              String    // Role being delegated
  
  // Delegation scope
  scope             Json      @default("{}") // Limitations on delegation
  requestTypes      Json      @default("[]") // Which request types can be delegated
  
  // Timing
  validFrom         DateTime  @default(now())
  validUntil        DateTime?
  isActive          Boolean   @default(true)
  
  // Constraints
  maxDelegations    Int       @default(1) // How many times this can be used
  usedCount         Int       @default(0)
  
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@unique([tenantId, delegatorId, delegateId, role])
  @@index([tenantId])
  @@index([delegatorId])
  @@index([delegateId])
  @@index([isActive])
  @@map("approval_delegations")
}
