model FeatureFlag {
  id                String    @id @default(uuid()) @db.Uuid
  billingAccountId  String?   @db.Uuid  @map("billing_account_id") // Optional: for usage tracking
  projectId         String?   @db.Uuid  @map("project_id") // Optional: for project-scoped flags
  key               String    // e.g., "new-dashboard", "enable-beta-feature"
  name              String @map("name")
  description       String?
  type              String    @default("boolean")  @map("type") // boolean, string, number
  isGlobal          Boolean   @default(false)  @map("is_global") // true if applies to all projects
  defaultValue      Json?      @map("default_value") // Default value for the flag
  metadata          Json      @default("{}") @map("metadata")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  environments      FeatureFlagEnvironment[]
  overrides         FeatureFlagOverride[]

  @@unique([billingAccountId, projectId, key])
  @@index([billingAccountId])
  @@index([projectId])
  @@index([key])
  @@index([isGlobal])
  @@index([deletedAt])
  @@map("feature_flags")
}

model FeatureFlagEnvironment {
  id                String    @id @default(uuid()) @db.Uuid
  flagId            String    @db.Uuid @map("flag_id")
  environment       String    // e.g., "production", "staging", "development"
  enabled           Boolean   @default(false)
  variant           Json?     // For string/number flags, the variant value
  config            Json      @default("{}") // Additional environment-specific config
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy         String?   @db.Uuid @map("updated_by")

  flag              FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, environment])
  @@index([flagId])
  @@index([environment])
  @@index([enabled])
  @@map("feature_flag_environments")
}

model FeatureFlagOverride {
  id                String    @id @default(uuid()) @db.Uuid
  flagId            String    @db.Uuid @map("flag_id")
  environment       String
  targetKey         String     @map("target_key") // userId, tenantId, or other identifier
  targetType        String    @default("user")  @map("target_type") // user, tenant, segment, etc.
  value             Json      // The override value
  metadata          Json      @default("{}") @map("metadata")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz

  flag              FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, environment, targetKey, targetType])
  @@index([flagId])
  @@index([environment])
  @@index([targetKey])
  @@index([expiresAt])
  @@map("feature_flag_overrides")
