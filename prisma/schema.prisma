// ============================================================================
// IDEMPOTENCY MODELS
// Request idempotency for safe retries
// ============================================================================

model IdempotencyKey {
  id                String    @id @default(uuid())
  key               String    @unique // The idempotency key
  status            String    @default("pending") // pending, completed, failed
  response          Json?     // Cached response for completed requests
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  expiresAt         DateTime  // Auto-cleanup after 24 hours

  @@index([key])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// INGESTION PIPELINE MODELS
// Universal ingestion system for connectors and imports
// ============================================================================

model IngestionSource {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  name              String
  type              String    // "csv", "stripe", "shopify", "manual", etc.
  connectorType     String?   // "stripe", "shopify", etc. (null for CSV/manual)
  configEncrypted   String?   @db.Text // Encrypted connector config (API keys, OAuth tokens)
  configMetadata    Json      @default("{}") // Non-sensitive metadata (connector name, etc.)
  status            String    @default("active") // active, paused, error
  lastSyncAt        DateTime?
  lastSyncStatus    String?   // success, failed, partial
  lastSyncError     String?   @db.Text
  syncSchedule      String?   // Cron expression for scheduled syncs
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  ingestions        Ingestion[]
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([connectorType])
  @@index([status])
  @@index([deletedAt])
  @@map("ingestion_sources")
}

model Ingestion {
  id                String    @id @default(uuid())
  sourceId          String    @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  idempotencyKey    String?   @unique // For idempotent retries
  status            String    @default("pending") // pending, processing, completed, failed
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  errorMessage      String?   @db.Text
  errorStack        String?   @db.Text
  traceId           String?   // For observability
  rawRecordCount    Int       @default(0)
  normalizedCount   Int       @default(0)
  failedCount       Int       @default(0)
  retryCount        Int       @default(0)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawRecords        RawRecord[]
  normalizedTransactions NormalizedTransaction[]
  reconciliationRuns ReconciliationRun[]

  @@index([sourceId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([startedAt(sort: Desc)])
  @@map("ingestions")
}

model RawRecord {
  id                String    @id @default(uuid())
  ingestionId       String    @db.Uuid
  sourceId          String    @db.Uuid
  tenantId          String    @db.Uuid
  rawData           Json      // Original raw data from source
  rowNumber         Int?      // For CSV imports
  externalId        String?   // External ID from source system
  status            String    @default("pending") // pending, normalized, failed
  errorMessage      String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  normalizedTransaction NormalizedTransaction?

  @@index([ingestionId])
  @@index([sourceId])
  @@index([tenantId])
  @@index([externalId])
  @@index([status])
  @@map("raw_records")
}

model NormalizedTransaction {
  id                String    @id @default(uuid())
  ingestionId       String    @db.Uuid
  rawRecordId       String?   @db.Uuid @unique
  tenantId          String    @db.Uuid
  sourceId          String    @db.Uuid
  externalId        String?   // External ID from source system
  amount            Decimal   @db.Decimal(15, 2)
  currency          String    @default("USD")
  date              DateTime  @db.Date
  description       String?   @db.Text
  category          String?
  paymentMethod     String?
  reference         String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ingestion         Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  rawRecord         RawRecord? @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)
  source            IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceMatches         ReconciliationMatch[] @relation("SourceMatches")
  targetMatches         ReconciliationMatch[] @relation("TargetMatches")

  @@index([ingestionId])
  @@index([rawRecordId])
  @@index([tenantId])
  @@index([sourceId])
  @@index([externalId])
  @@index([date])
  @@index([amount])
  @@index([currency])
  @@index([tenantId, date, amount, currency])
  @@map("normalized_transactions")
}

model ReconciliationRun {
  id                String    @id @default(uuid())
  ingestionId       String?   @map("ingestion_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  name              String?
  status            String    @default("pending") // pending, running, completed, failed
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  sourceCount       Int       @default(0) @map("source_count")
  targetCount       Int       @default(0) @map("target_count")
  matchedCount      Int       @default(0) @map("matched_count")
  unmatchedSourceCount Int    @default(0) @map("unmatched_source_count")
  unmatchedTargetCount Int    @default(0) @map("unmatched_target_count")
  confidenceAvg     Decimal?  @map("confidence_avg") @db.Decimal(5, 4)
  errorMessage      String?   @map("error_message") @db.Text
  traceId           String?   @map("trace_id")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  ingestion         Ingestion? @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  matches           ReconciliationMatch[]
  provenance        ReconciliationProvenance[]

  @@index([ingestionId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("reconciliation_runs")
}

model ReconciliationMatch {
  id                String    @id @default(uuid())
  runId             String    @db.Uuid
  sourceTransactionId String  @db.Uuid
  targetTransactionId String?  @db.Uuid
  tenantId          String    @db.Uuid
  matchType         String    // "exact", "fuzzy", "manual", "unmatched"
  confidence        Decimal   @db.Decimal(5, 4) // 0.0000 to 1.0000
  matchReason       String?   @db.Text
  amountDiff        Decimal?  @db.Decimal(15, 2)
  dateDiff          Int?      // Days difference
  reviewed          Boolean   @default(false)
  reviewedBy        String?   @db.Uuid
  reviewedAt        DateTime?
  // Enterprise exception workflow fields
  status            String    @default("open") // open, in_progress, resolved, dismissed
  assignedTo        String?   @db.Uuid // Operator assigned to resolve this exception
  resolutionReason  String?   @db.VarChar(100) // Structured reason for resolution
  notes             String?   @db.Text // Operator notes during adjudication
  severity          String    @default("medium") // low, medium, high, critical
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  run               ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceTransaction NormalizedTransaction @relation("SourceMatches", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  targetTransaction NormalizedTransaction? @relation("TargetMatches", fields: [targetTransactionId], references: [id], onDelete: SetNull)
  provenance        ReconciliationProvenance[]
  adjudicationMemories ExceptionAdjudicationMemory[]
  archetypeClassifications ExceptionArchetypeClassification[]

  @@index([runId])
  @@index([tenantId])
  @@index([sourceTransactionId])
  @@index([targetTransactionId])
  @@index([matchType])
  @@index([confidence])
  @@index([reviewed])
  @@index([tenantId, status, assignedTo])
  @@index([tenantId, status, severity])
  @@map("reconciliation_matches")
}



model ReconciliationProvenance {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id") @db.Uuid
  runId             String   @map("run_id") @db.Uuid
  matchId           String?  @map("match_id") @db.Uuid
  sequence          Int
  eventType         String   @map("event_type")
  actorType         String   @default("system") @map("actor_type")
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  details           Json     @default("{}")
  entryHash         String   @map("entry_hash")
  createdAt         DateTime @default(now()) @map("created_at")

  run               ReconciliationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  match             ReconciliationMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([runId, sequence])
  @@index([tenantId])
  @@index([runId])
  @@index([matchId])
  @@index([eventType])
  @@index([createdAt])
  @@map("reconciliation_provenance")
}

// ============================================================================
// EXCEPTION ONTOLOGY & ADJUDICATION MEMORY MODELS
// Phase II: Reconciliation-Intelligence primitives for compounding knowledge
// ============================================================================

model ExceptionArchetype {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  code              String    // e.g., "AMOUNT_MISMATCH", "DATE_DRIFT", "MISSING_IN_SOURCE"
  label             String    // Human-readable label
  description       String?   @db.Text
  category          String    // "amount", "timing", "missing", "duplicate", "classification"
  severityDefault   String    @default("medium") // default severity for this archetype
  typicalResolution String?   // Common resolution for this archetype type
  resolutionTaxonomy Json     @default("[]") // Allowed resolutions for this archetype
  matchPattern      Json?     // JSON pattern for auto-classification hints
  matchFieldWeights Json?     @default("{}") // Weights for field-based matching
  isActive          Boolean   @default(true)
  isSystem          Boolean   @default(false) // System-defined archetypes cannot be deleted
  occurrenceCount   Int       @default(0) // Running count for prioritization
  lastOccurrenceAt  DateTime?
  metadata          Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  adjudicationMemories ExceptionAdjudicationMemory[]
  archetypeClassifications ExceptionArchetypeClassification[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
  @@index([occurrenceCount(sort: Desc)])
  @@map("exception_archetypes")
}

model ExceptionArchetypeClassification {
  id                String    @id @default(uuid())
  exceptionId       String    @db.Uuid // FK to ReconciliationMatch.id
  archetypeId       String    @db.Uuid // FK to ExceptionArchetype.id
  tenantId          String    @db.Uuid
  confidence        Decimal   @db.Decimal(5, 4) // Classification confidence score
  matchFeatures     Json      @default("{}") // Which features triggered this classification
  classifiedAt      DateTime  @default(now())
  classifiedBy      String    @default("system") // "system", "human", "ml"
  metadata          Json      @default("{}")

  exception         ReconciliationMatch @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  archetype        ExceptionArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)

  @@unique([exceptionId, archetypeId])
  @@index([exceptionId])
  @@index([archetypeId])
  @@index([tenantId])
  @@index([confidence])
  @@index([classifiedAt])
  @@map("exception_archetype_classifications")
}

model ExceptionAdjudicationMemory {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  exceptionId       String    @db.Uuid // FK to ReconciliationMatch.id
  archetypeId       String?   @db.Uuid // FK to ExceptionArchetype.id (optional - can be classified later)
  
  // Structured resolution capture
  resolution        String    // matched, manual, ignored, duplicate, escalated
  resolutionReason String?   // Specific reason within the resolution category
  resolutionCode   String?   // Machine-readable resolution code
  
  // Actor tracking
  adjudicatorId     String    @db.Uuid
  adjudicatorType   String    @default("operator") // operator, supervisor, system, automated_rule
  adjudicationType   String    @default("initial") // initial, re_adjudication, escalated_review, auto_resolved
  
  // Temporal tracking
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  durationMs       BigInt?   // Time spent on adjudication
  
  // Outcome tracking
  outcome           String?   // resolved, escalated, reopened, confirmed_dismissed
  confidence        Decimal?  @db.Decimal(5, 4) // Confidence in the resolution
  reversibility     String?   // reversible, irreversible, pending_reversal
  
  // Lineage for reopen/escalation
  parentMemoryId    String?   @db.Uuid // Previous adjudication if reopened/escalated
  escalatedTo       String?   // Queue or user escalated to
  escalationReason  String?   @db.Text
  
  // Evidence references
  evidenceIds       Json      @default("[]") // Array of evidence artifact IDs used
  sourceTrustScore  Decimal?  @db.Decimal(5, 4) // Trust score for source data
  
  // Annotations and context
  annotations       Json      @default("{}") // Structured key-value annotations
  operatorNotes     String?   @db.Text // Freeform operator notes
  systemNotes       String?   @db.Text // System-generated notes (why flagged, suggestions)
  
  // Policy tuning signals
  suggestedPolicyChange Json? // Hint for policy improvement
  policyChangeAccepted   Boolean? // Whether suggestion was implemented
  
  // Provenance chain
  entryHash         String    // Hash for audit chain integrity
  metadata          Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  exception         ReconciliationMatch @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  archetype         ExceptionArchetype? @relation(fields: [archetypeId], references: [id], onDelete: SetNull)
  parentMemory      ExceptionAdjudicationMemory? @relation("AdjudicationChain", fields: [parentMemoryId], references: [id], onDelete: SetNull)
  childMemories     ExceptionAdjudicationMemory[] @relation("AdjudicationChain")

  @@index([tenantId])
  @@index([exceptionId])
  @@index([archetypeId])
  @@index([adjudicatorId])
  @@index([resolution])
  @@index([outcome])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId, resolution, createdAt(sort: Desc)])
  @@map("exception_adjudication_memory")
}

