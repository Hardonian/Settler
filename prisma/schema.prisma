model NudgePolicy {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  name              String
  criteria          Json      @default("{}")
  channel           String    @default("email")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actions           NudgeAction[]

  @@index([tenantId])
  @@index([isActive])
  @@map("nudge_policies")
}

model NudgeAction {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  policyId          String    @db.Uuid @map("policy_id")
  invoiceId         String @map("invoice_id")
  targetContact     String @map("target_contact")
  status            String    @default("dry_run") // dry_run, pending, executed, failed
  executeAt         DateTime? @map("execute_at")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy            NudgePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([policyId])
  @@index([status])
  @@map("nudge_actions")
}

