// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// BILLING INFRASTRUCTURE MODELS
// ============================================================================

model BillingAccount {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid @map("user_id")
  tenantId          String?   @db.Uuid  @map("tenant_id") // Legacy field, consider migrating to Tenant.billingAccountId
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  stripeAccountId   String? @map("stripe_account_id")
  email             String
  name              String?
  address           Json?
  taxId             String? @map("tax_id")
  currency          String    @default("usd")
  status            String    @default("active") // active, suspended, cancelled
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  tenant            Tenant?   // Optional relation to Tenant model
  subscriptions     Subscription[]
  addOnPurchases    AddOnPurchase[]
  usageEvents       UsageEvent[]
  usageAggregates   UsageAggregateDaily[]
  usageCounters     UsageCounter[]

  @@index([userId])
  @@index([tenantId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("billing_accounts")
}

model Subscription {
  id                    String    @id @default(uuid()) @db.Uuid
  billingAccountId      String    @db.Uuid @map("billing_account_id")
  stripeSubscriptionId  String?   @unique @map("stripe_subscription_id")
  stripePriceId         String? @map("stripe_price_id")
  planId                String     @map("plan_id") // base, pro, enterprise
  planName              String     @map("plan_name") // "Settler Core"
  status                String    // active, cancelled, past_due, trialing
  currentPeriodStart    DateTime @map("current_period_start") @db.Timestamptz
  currentPeriodEnd      DateTime @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd     Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz
  trialStart            DateTime? @map("trial_start") @db.Timestamptz
  trialEnd              DateTime? @map("trial_end") @db.Timestamptz
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  billingAccount        BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model StripeEvent {
 id String @id @default(uuid())
  eventId       String    @unique  @map("event_id") // Stripe event.id
  type          String    // Event type (e.g., checkout.session.completed)
  status        String    @default("received") // received, processed, failed
  receivedAt    DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  error         String?   @db.Text @map("error")
  userId        String?   @db.Uuid @map("user_id")
  tenantId      String?   @db.Uuid @map("tenant_id")
  billingAccountId String? @db.Uuid @map("billing_account_id")
  rawPayload    Json?      @map("raw_payload") // Full event payload for debugging
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([eventId])
  @@index([type])
  @@index([status])
  @@index([receivedAt])
  @@index([userId])
  @@index([tenantId])
  @@index([billingAccountId])
  @@map("stripe_events")
}

model AddOn {
  id                String    @id @default(uuid()) @db.Uuid
  integrationId     String    @unique  @map("integration_id") // tiktok, wix, ga4, paypal-payouts, whatsapp-telegram
  name              String    // "TikTok Shop + TikTok Ads"
  description       String?
  category          String    // integration, feature, support
  basePriceMonthly  Decimal   @db.Decimal(10, 2) @map("base_price_monthly")
  usagePricePerUnit Decimal?  @db.Decimal(10, 6)  @map("usage_price_per_unit") // per order, per event, etc.
  usageUnit         String?    @map("usage_unit") // order, event, message, payout
  stripeProductId   String? @map("stripe_product_id")
  stripePriceId     String? @map("stripe_price_id")
  isActive          Boolean   @default(true) @map("is_active")
  isStandard        Boolean   @default(false)  @map("is_standard") // true if included in base plan
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  purchases         AddOnPurchase[]

  @@index([integrationId])
  @@index([isActive])
  @@index([isStandard])
  @@map("add_ons")
}

model AddOnPurchase {
  id                String    @id @default(uuid()) @db.Uuid
  billingAccountId  String    @db.Uuid @map("billing_account_id")
  addOnId           String    @db.Uuid @map("add_on_id")
  stripeSubscriptionItemId String? @unique @map("stripe_subscription_item_id")
  status            String    @default("active") // active, cancelled, expired
  purchasedAt       DateTime  @default(now()) @map("purchased_at") @db.Timestamptz
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  addOn             AddOn @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  @@index([billingAccountId])
  @@index([addOnId])
  @@index([status])
  @@map("add_on_purchases")
}

model UsageEvent {
  id                String    @id @default(uuid()) @db.Uuid
  billingAccountId  String    @db.Uuid @map("billing_account_id")
  projectId         String?   @db.Uuid @map("project_id")
  userId            String?   @db.Uuid @map("user_id")
  tenantId          String?   @db.Uuid @map("tenant_id")
  eventType        String     @map("event_type") // auth_user_created, db_query, webhook_event, ai_request, etc.
  integrationId     String?    @map("integration_id") // stripe, shopify, tiktok, etc.
  addOnId           String?   @db.Uuid @map("add_on_id")
  quantity          Decimal   @db.Decimal(15, 6) // can be fractional
  unit              String?   // request, job, event, message, etc.
  metadata          Json?
  timestamp         DateTime  @default(now()) @db.Timestamptz
  aggregated        Boolean   @default(false) // true once aggregated into daily table

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([projectId])
  @@index([userId])
  @@index([tenantId])
  @@index([eventType])
  @@index([integrationId])
  @@index([timestamp])
  @@index([aggregated])
  @@index([billingAccountId, eventType, timestamp])
  @@map("usage_events")
}

model UsageAggregateDaily {
  id                String    @id @default(uuid()) @db.Uuid @map("id")
  billingAccountId  String    @db.Uuid @map("billing_account_id")
  projectId         String?   @db.Uuid @map("project_id")
  tenantId          String?   @db.Uuid @map("tenant_id")
  date              DateTime  @db.Date
  eventType         String @map("event_type")
  integrationId     String? @map("integration_id")
  addOnId           String?   @db.Uuid @map("add_on_id")
  totalQuantity     Decimal   @db.Decimal(15, 6) @map("total_quantity")
  eventCount        BigInt    @default(0) @map("event_count")
  estimatedCost     Decimal?  @db.Decimal(10, 2) @map("estimated_cost")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, projectId, date, eventType, integrationId, addOnId])
  @@index([billingAccountId])
  @@index([projectId])
  @@index([tenantId])
  @@index([date])
  @@index([eventType])
  @@index([integrationId])
  @@map("usage_aggregate_daily")
}

model UsageCounter {
  id                String    @id @default(uuid()) @db.Uuid @map("id")
  billingAccountId  String    @db.Uuid @map("billing_account_id")
  service           String     @map("service") // 'reconcile', 'receipts', 'featureFlags', 'playground'
  period            String     @map("period") // 'daily', 'monthly'
  periodStart       DateTime  @db.Date @map("period_start")
  count             BigInt    @default(0)
  limit             Int       @default(0)  @map("limit") // Cached limit for reference
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, service, period, periodStart])
  @@index([billingAccountId, service, period])
  @@index([periodStart])
  @@map("usage_counters")
}

// ============================================================================
// RECON CORE ENGINE MODELS
// Phase I: Foundational Recon Core Engine
// ============================================================================

model ReconJob {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  name               String
  description        String?
  templateId         String?   @map("template_id") @db.Uuid
  sourceAdapter      String    @map("source_adapter")
  sourceConfigEncrypted String @map("source_config_encrypted") @db.Text
  targetAdapter      String    @map("target_adapter")
  targetConfigEncrypted String @map("target_config_encrypted") @db.Text
  mappingTemplateId  String?   @map("mapping_template_id") @db.Uuid
  transformRecipeId  String?   @map("transform_recipe_id") @db.Uuid
  validationRules    Json      @default("[]") @map("validation_rules")
  reconStrategy      String    @default("deterministic") @map("recon_strategy")
  scheduleCron       String?   @map("schedule_cron")
  scheduleTimezone   String    @default("UTC") @map("schedule_timezone")
  nextExecutionAt    DateTime? @map("next_execution_at") @db.Timestamptz
  status             String    @default("active")
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  template           ReconTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mappingTemplate    MappingTemplate? @relation(fields: [mappingTemplateId], references: [id], onDelete: SetNull)
  transformRecipe    TransformRecipe? @relation(fields: [transformRecipeId], references: [id], onDelete: SetNull)
  results            ReconResult[]
  audits             ReconAudit[]
  scheduledJobs      ScheduledJob[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([templateId])
  @@map("recon_jobs")
}

model ScheduledJob {
  id               String    @id @default(uuid()) @db.Uuid
  reconJobId       String    @map("recon_job_id") @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  status           String    @default("pending") // pending, running, completed, failed
  scheduledFor     DateTime  @map("scheduled_for")
  lockedAt         DateTime? @map("locked_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  attempts         Int       @default(0)
  error            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  reconJob         ReconJob  @relation(fields: [reconJobId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([reconJobId])
  @@map("scheduled_jobs")
}

model ReconResult {
  id                    String    @id @default(uuid()) @db.Uuid
  reconJobId            String?   @map("recon_job_id") @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  ingestionId           String?   @map("ingestion_id") @db.Uuid
  executionId           String?   @map("execution_id") @db.Uuid
  snapshotId            String?   @map("snapshot_id") @db.Uuid
  inputHash             String?   @map("input_hash")
  status                String    @default("running")
  startedAt             DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt           DateTime? @map("completed_at") @db.Timestamptz
  sourceCount           Int       @default(0) @map("source_count")
  targetCount           Int       @default(0) @map("target_count")
  matchedCount          Int       @default(0) @map("matched_count")
  unmatchedSourceCount  Int       @default(0) @map("unmatched_source_count")
  unmatchedTargetCount  Int       @default(0) @map("unmatched_target_count")
  conflictCount         Int       @default(0) @map("conflict_count")
  totalAmountSource     Decimal?  @map("total_amount_source") @db.Decimal(15, 2)
  totalAmountTarget     Decimal?  @map("total_amount_target") @db.Decimal(15, 2)
  totalAmountMatched    Decimal?  @map("total_amount_matched") @db.Decimal(15, 2)
  totalAmountUnmatched  Decimal?  @map("total_amount_unmatched") @db.Decimal(15, 2)
  currency              String?
  confidenceAvg         Decimal?  @map("confidence_avg") @db.Decimal(5, 4)
  confidenceMin         Decimal?  @map("confidence_min") @db.Decimal(5, 4)
  confidenceMax         Decimal?  @map("confidence_max") @db.Decimal(5, 4)
  durationMs            BigInt?   @map("duration_ms")
  errorMessage          String?   @map("error_message") @db.Text
  errorStack            String?   @map("error_stack") @db.Text
  summary               Json      @default("{}")
  metadata              Json      @default("{}")
  proofCapsule          Json?     @default("{}") @map("proof_capsule")
  proofpackPayload      Json?     @map("proofpack_payload")
  proofpackHash         String?   @map("proofpack_hash")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  reconJob              ReconJob? @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  snapshot              RunSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  audits                ReconAudit[]
  provenance            ExecutionProvenance[]

  @@index([reconJobId])
  @@index([tenantId])
  @@index([status])
  @@index([reconJobId, tenantId, status, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([snapshotId])
  @@index([inputHash])
  @@map("recon_results")
}

model RunSnapshot {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid @map("tenant_id")
  reconJobId            String    @db.Uuid @map("recon_job_id")
  inputHash             String    @unique @map("input_hash")
  sourceDataHash        String @map("source_data_hash")
  targetDataHash        String @map("target_data_hash")
  adapterConfigHashes   Json      @default("{}") @map("adapter_config_hashes")
  jobConfig             Json      @default("{}") @map("job_config")
  ruleVersions          Json      @default("[]") @map("rule_versions")
  engineVersion         String    @default("1.0.0") @map("engine_version")
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  results               ReconResult[]

  @@index([tenantId])
  @@index([reconJobId])
  @@index([inputHash])
  @@index([createdAt(sort: Desc)])
  @@map("run_snapshots")
}

model ExecutionProvenance {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid @map("tenant_id")
  runResultId           String    @db.Uuid @map("run_result_id")
  snapshotId            String    @db.Uuid @map("snapshot_id")
  sequence              Int
  operation             String
  entityType            String @map("entity_type")
  entityId              String    @db.Uuid @map("entity_id")
  ruleId                String?   @db.Uuid @map("rule_id")
  ruleVersion           Int? @map("rule_version")
  confidence            Decimal?  @db.Decimal(5, 4)
  actor                 String    @default("system")
  actorUserId           String?   @db.Uuid @map("actor_user_id")
  details               Json      @default("{}") @map("details")
  entryHash             String @map("entry_hash")
  timestamp             DateTime  @default(now()) @db.Timestamptz

  runResult             ReconResult @relation(fields: [runResultId], references: [id], onDelete: Cascade)

  @@unique([runResultId, sequence])
  @@index([tenantId])
  @@index([runResultId])
  @@index([snapshotId])
  @@index([operation])
  @@index([entityId])
  @@index([timestamp])
  @@map("execution_provenance")
}

model ReconTemplate {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @db.Uuid @map("tenant_id")
  name              String
  description       String? @map("description")
  category          String? @map("category")
  sourceAdapterType String? @map("source_adapter_type")
  targetAdapterType String? @map("target_adapter_type")
  reconStrategy     String    @default("deterministic") @map("recon_strategy")
  matchingRules     Json      @default("[]") @map("matching_rules")
  validationRules   Json      @default("[]") @map("validation_rules")
  transformRules    Json      @default("[]") @map("transform_rules")
  isPublic          Boolean   @default(false) @map("is_public")
  isSystem          Boolean   @default(false) @map("is_system")
  usageCount        Int       @default(0) @map("usage_count")
  metadata          Json      @default("{}") @map("metadata")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([category])
  @@index([isPublic])
  @@map("recon_templates")
}

model ReconAudit {
  id            String    @id @default(uuid()) @db.Uuid
  reconJobId    String?   @db.Uuid @map("recon_job_id")
  reconResultId String?   @db.Uuid @map("recon_result_id")
  tenantId      String    @db.Uuid @map("tenant_id")
  userId        String?   @db.Uuid @map("user_id")
  auditType     String @map("audit_type")
  action        String
  entityType    String? @map("entity_type")
  entityId      String?   @db.Uuid @map("entity_id")
  changes       Json?
  beforeState   Json? @map("before_state")
  afterState    Json? @map("after_state")
  ipAddress     String? @map("ip_address")
  userAgent     String?   @db.Text @map("user_agent")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  reconJob      ReconJob? @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  reconResult   ReconResult? @relation(fields: [reconResultId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([reconResultId])
  @@index([auditType])
  @@index([createdAt(sort: Desc)])
  @@map("recon_audits")
}

model MappingTemplate {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId           String?   @db.Uuid @map("tenant_id")
  name               String
  description        String?
  sourceSchema       Json @map("source_schema")
  targetSchema       Json @map("target_schema")
  fieldMappings      Json      @default("{}") @map("field_mappings")
  transformationRules Json     @default("[]") @map("transformation_rules")
  validationRules    Json      @default("[]") @map("validation_rules")
  isPublic           Boolean   @default(false) @map("is_public")
  isSystem           Boolean   @default(false) @map("is_system")
  usageCount         Int       @default(0) @map("usage_count")
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  jobs               ReconJob[]

  @@index([tenantId])
  @@index([isPublic])
  @@map("mapping_templates")
}

model ValidationRule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid @map("tenant_id")
  name        String
  description String?
  ruleType    String @map("rule_type")
  ruleConfig  Json @map("rule_config")
  severity    String    @default("error")
  isActive    Boolean   @default(true) @map("is_active")
  isPublic    Boolean   @default(false) @map("is_public")
  isSystem    Boolean   @default(false) @map("is_system")
  usageCount  Int       @default(0) @map("usage_count")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@index([ruleType])
  @@index([isActive])
  @@index([isPublic])
  @@map("validation_rules")
}

model CustomMatchingRule {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @db.Uuid @map("tenant_id")
  name              String
  description       String?
  matchConditions   Json      @default("{}")  @map("match_conditions") // JSON object defining matching criteria
  matchStrategy     String    @default("exact")  @map("match_strategy") // exact, fuzzy, regex, custom
  priority          Int       @default(0)  @map("priority") // Lower values = higher priority
  isActive          Boolean   @default(true) @map("is_active")
  isPublic          Boolean   @default(false) @map("is_public")
  isSystem          Boolean   @default(false) @map("is_system")
  applicableSources Json      @default("[]")  @map("applicable_sources") // Array of source adapter types this rule applies to
  applicableTargets Json      @default("[]")  @map("applicable_targets") // Array of target adapter types this rule applies to
  usageCount        Int       @default(0) @map("usage_count")
  metadata          Json      @default("{}") @map("metadata")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@index([matchStrategy])
  @@index([priority])
  @@index([isActive])
  @@index([isPublic])
  @@map("custom_matching_rules")
}

model TransformRecipe {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @db.Uuid @map("tenant_id")
  name              String
  description       String?
  recipeType        String @map("recipe_type")
  inputSchema       Json @map("input_schema")
  outputSchema      Json @map("output_schema")
  transformationSteps Json    @default("[]") @map("transformation_steps")
  validationRules   Json      @default("[]") @map("validation_rules")
  isPublic          Boolean   @default(false) @map("is_public")
  isSystem          Boolean   @default(false) @map("is_system")
  usageCount        Int       @default(0) @map("usage_count")
  version           Int       @default(1)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([recipeType])
  @@index([isPublic])
  @@map("transform_recipes")
}

model ContractVersion {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  contractName      String @map("contract_name")
  version           String
  schemaDefinition  Json @map("schema_definition")
  isActive          Boolean   @default(true) @map("is_active")
  isDeprecated      Boolean   @default(false) @map("is_deprecated")
  deprecatedAt      DateTime? @map("deprecated_at") @db.Timestamptz
  breakingChanges   Json      @default("[]") @map("breaking_changes")
  migrationGuide    String?   @db.Text @map("migration_guide")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  driftEvents       DriftEvent[]

  @@unique([tenantId, contractName, version])
  @@index([tenantId])
  @@index([contractName])
  @@index([isActive])
  @@map("contract_versions")
}

// reconJobId is a run-scoped UUID in the console: it may reference ReconciliationRun.id
// (ingestion execution) or ReconJob.id (recon job definition). There is no single FK target,
// so integrity is enforced in application code (tenant-scoped resolution).
model DriftEvent {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  reconJobId        String?   @db.Uuid @map("recon_job_id")
  contractVersionId String?   @db.Uuid @map("contract_version_id")
  driftType         String @map("drift_type")
  severity          String    @default("warning")
  fieldPath         String? @map("field_path")
  expectedValue     Json? @map("expected_value")
  actualValue       Json? @map("actual_value")
  driftMetrics      Json      @default("{}") @map("drift_metrics")
  autoRepaired      Boolean   @default(false) @map("auto_repaired")
  repairAction      Json? @map("repair_action")
  acknowledged      Boolean   @default(false)
  acknowledgedBy    String?   @db.Uuid @map("acknowledged_by")
  acknowledgedAt     DateTime? @map("acknowledged_at") @db.Timestamptz
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  contractVersion   ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([driftType])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@index([acknowledged])
  @@map("drift_events")
}

model WorkflowRun {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid @map("tenant_id")
  workflowId    String @map("workflow_id")
