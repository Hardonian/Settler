// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// BILLING INFRASTRUCTURE MODELS
// ============================================================================

model BillingAccount {
  id                String    @id @default(uuid())
  userId            String    @db.Uuid
  tenantId          String?   @db.Uuid // Legacy field, consider migrating to Tenant.billingAccountId
  stripeCustomerId  String?   @unique
  stripeAccountId   String?
  email             String
  name              String?
  address           Json?
  taxId             String?
  currency          String    @default("usd")
  status            String    @default("active") // active, suspended, cancelled
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant            Tenant?   // Optional relation to Tenant model
  subscriptions     Subscription[]
  addOnPurchases    AddOnPurchase[]
  usageEvents       UsageEvent[]
  usageAggregates   UsageAggregateDaily[]
  usageCounters     UsageCounter[]

  @@index([userId])
  @@index([tenantId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("billing_accounts")
}

model Subscription {
  id                    String    @id @default(uuid())
  billingAccountId      String    @db.Uuid
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  planId                String    // base, pro, enterprise
  planName              String    // "Settler Core"
  status                String    // active, cancelled, past_due, trialing
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  cancelledAt           DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  billingAccount        BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model StripeEvent {
  id            String    @id @default(uuid())
  eventId       String    @unique // Stripe event.id
  type          String    // Event type (e.g., checkout.session.completed)
  status        String    @default("received") // received, processed, failed
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  error         String?   @db.Text
  userId        String?   @db.Uuid
  tenantId      String?   @db.Uuid
  billingAccountId String? @db.Uuid
  rawPayload    Json?     // Full event payload for debugging
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([eventId])
  @@index([type])
  @@index([status])
  @@index([receivedAt])
  @@index([userId])
  @@index([tenantId])
  @@index([billingAccountId])
  @@map("stripe_events")
}

model AddOn {
  id                String    @id @default(uuid())
  integrationId     String    @unique // tiktok, wix, ga4, paypal-payouts, whatsapp-telegram
  name              String    // "TikTok Shop + TikTok Ads"
  description       String?
  category          String    // integration, feature, support
  basePriceMonthly  Decimal   @db.Decimal(10, 2)
  usagePricePerUnit Decimal?  @db.Decimal(10, 6) // per order, per event, etc.
  usageUnit         String?   // order, event, message, payout
  stripeProductId   String?
  stripePriceId     String?
  isActive          Boolean   @default(true)
  isStandard        Boolean   @default(false) // true if included in base plan
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchases         AddOnPurchase[]

  @@index([integrationId])
  @@index([isActive])
  @@index([isStandard])
  @@map("add_ons")
}

model AddOnPurchase {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  addOnId           String    @db.Uuid
  stripeSubscriptionItemId String? @unique
  status            String    @default("active") // active, cancelled, expired
  purchasedAt       DateTime  @default(now())
  cancelledAt       DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  addOn             AddOn @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  @@index([billingAccountId])
  @@index([addOnId])
  @@index([status])
  @@map("add_on_purchases")
}

model UsageEvent {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  projectId         String?   @db.Uuid
  userId            String?   @db.Uuid
  tenantId          String?   @db.Uuid
  eventType        String    // auth_user_created, db_query, webhook_event, ai_request, etc.
  integrationId     String?   // stripe, shopify, tiktok, etc.
  addOnId           String?   @db.Uuid
  quantity          Decimal   @db.Decimal(15, 6) // can be fractional
  unit              String?   // request, job, event, message, etc.
  metadata          Json?
  timestamp         DateTime  @default(now())
  aggregated        Boolean   @default(false) // true once aggregated into daily table

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([projectId])
  @@index([userId])
  @@index([tenantId])
  @@index([eventType])
  @@index([integrationId])
  @@index([timestamp])
  @@index([aggregated])
  @@index([billingAccountId, eventType, timestamp])
  @@map("usage_events")
}

model UsageAggregateDaily {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  projectId         String?   @db.Uuid
  tenantId          String?   @db.Uuid
  date              DateTime  @db.Date
  eventType         String
  integrationId     String?
  addOnId           String?   @db.Uuid
  totalQuantity     Decimal   @db.Decimal(15, 6)
  eventCount        Int       @default(0)
  estimatedCost     Decimal?  @db.Decimal(10, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, projectId, date, eventType, integrationId, addOnId])
  @@index([billingAccountId])
  @@index([projectId])
  @@index([tenantId])
  @@index([date])
  @@index([eventType])
  @@index([integrationId])
  @@map("usage_aggregate_daily")
}

model UsageCounter {
  id                String    @id @default(uuid())
  billingAccountId  String    @db.Uuid
  service           String    // 'reconcile', 'receipts', 'featureFlags', 'playground'
  period            String    // 'daily', 'monthly'
  periodStart       DateTime  @db.Date
  count             Int       @default(0)
  limit             Int       @default(0) // Cached limit for reference
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, service, period, periodStart])
  @@index([billingAccountId, service, period])
  @@index([periodStart])
  @@map("usage_counters")
}

// ============================================================================
// RECON CORE ENGINE MODELS
// Phase I: Foundational Recon Core Engine
// ============================================================================

model ReconJob {
  id                String    @id @default(uuid())
  tenantId           String    @map("tenant_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  name               String
  description        String?
  templateId         String?   @map("template_id") @db.Uuid
  sourceAdapter      String    @map("source_adapter")
  sourceConfigEncrypted String @map("source_config_encrypted") @db.Text
  targetAdapter      String    @map("target_adapter")
  targetConfigEncrypted String @map("target_config_encrypted") @db.Text
  mappingTemplateId  String?   @map("mapping_template_id") @db.Uuid
  transformRecipeId  String?   @map("transform_recipe_id") @db.Uuid
  validationRules    Json      @default("[]") @map("validation_rules")
  reconStrategy      String    @default("deterministic") @map("recon_strategy")
  scheduleCron       String?   @map("schedule_cron")
  scheduleTimezone   String    @default("UTC") @map("schedule_timezone")
  status             String    @default("active")
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  template           ReconTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mappingTemplate    MappingTemplate? @relation(fields: [mappingTemplateId], references: [id], onDelete: SetNull)
  transformRecipe    TransformRecipe? @relation(fields: [transformRecipeId], references: [id], onDelete: SetNull)
  results            ReconResult[]
  audits             ReconAudit[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([templateId])
  @@map("recon_jobs")
}

model ReconResult {
  id                    String    @id @default(uuid())
  reconJobId            String    @map("recon_job_id") @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  executionId           String?   @map("execution_id") @db.Uuid
  snapshotId            String?   @map("snapshot_id") @db.Uuid
  inputHash             String?   @map("input_hash")
  status                String    @default("running")
  startedAt             DateTime  @default(now()) @map("started_at")
  completedAt           DateTime? @map("completed_at")
  sourceCount           Int       @default(0) @map("source_count")
  targetCount           Int       @default(0) @map("target_count")
  matchedCount          Int       @default(0) @map("matched_count")
  unmatchedSourceCount  Int       @default(0) @map("unmatched_source_count")
  unmatchedTargetCount  Int       @default(0) @map("unmatched_target_count")
  conflictCount         Int       @default(0) @map("conflict_count")
  totalAmountSource     Decimal?  @map("total_amount_source") @db.Decimal(15, 2)
  totalAmountTarget     Decimal?  @map("total_amount_target") @db.Decimal(15, 2)
  totalAmountMatched    Decimal?  @map("total_amount_matched") @db.Decimal(15, 2)
  totalAmountUnmatched  Decimal?  @map("total_amount_unmatched") @db.Decimal(15, 2)
  currency              String?
  confidenceAvg         Decimal?  @map("confidence_avg") @db.Decimal(5, 4)
  confidenceMin         Decimal?  @map("confidence_min") @db.Decimal(5, 4)
  confidenceMax         Decimal?  @map("confidence_max") @db.Decimal(5, 4)
  durationMs            BigInt?   @map("duration_ms")
  errorMessage          String?   @map("error_message") @db.Text
  errorStack            String?   @map("error_stack") @db.Text
  summary               Json      @default("{}")
  metadata              Json      @default("{}")
  proofCapsule          Json?     @default("{}") @map("proof_capsule")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  reconJob              ReconJob @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  snapshot              RunSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  audits                ReconAudit[]
  provenance            ExecutionProvenance[]

  @@index([reconJobId])
  @@index([tenantId])
  @@index([status])
  @@index([reconJobId, tenantId, status, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([snapshotId])
  @@index([inputHash])
  @@map("recon_results")
}

model RunSnapshot {
  id                    String    @id @default(uuid())
  tenantId              String    @db.Uuid
  reconJobId            String    @db.Uuid
  inputHash             String    @unique
  sourceDataHash        String
  targetDataHash        String
  adapterConfigHashes   Json      @default("{}")
  jobConfig             Json      @default("{}")
  ruleVersions          Json      @default("[]")
  engineVersion         String    @default("1.0.0")
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now())

  results               ReconResult[]

  @@index([tenantId])
  @@index([reconJobId])
  @@index([inputHash])
  @@index([createdAt(sort: Desc)])
  @@map("run_snapshots")
}

model ExecutionProvenance {
  id                    String    @id @default(uuid())
  tenantId              String    @db.Uuid
  runResultId           String    @db.Uuid
  snapshotId            String    @db.Uuid
  sequence              Int
  operation             String
  entityType            String
  entityId              String    @db.Uuid
  ruleId                String?   @db.Uuid
  ruleVersion           Int?
  confidence            Decimal?  @db.Decimal(5, 4)
  actor                 String    @default("system")
  actorUserId           String?   @db.Uuid
  details               Json      @default("{}")
  entryHash             String
  timestamp             DateTime  @default(now())

  runResult             ReconResult @relation(fields: [runResultId], references: [id], onDelete: Cascade)

  @@unique([runResultId, sequence])
  @@index([tenantId])
  @@index([runResultId])
  @@index([snapshotId])
  @@index([operation])
  @@index([entityId])
  @@index([timestamp])
  @@map("execution_provenance")
}

model ReconTemplate {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  name              String
  description       String?
  category          String?
  sourceAdapterType String?
  targetAdapterType String?
  reconStrategy     String    @default("deterministic")
  matchingRules     Json      @default("[]")
  validationRules   Json      @default("[]")
  transformRules    Json      @default("[]")
  isPublic          Boolean   @default(false)
  isSystem          Boolean   @default(false)
  usageCount        Int       @default(0)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([category])
  @@index([isPublic])
  @@map("recon_templates")
}

model ReconAudit {
  id            String    @id @default(uuid())
  reconJobId    String?   @db.Uuid
  reconResultId String?   @db.Uuid
  tenantId      String    @db.Uuid
  userId        String?   @db.Uuid
  auditType     String
  action        String
  entityType    String?
  entityId      String?   @db.Uuid
  changes       Json?
  beforeState   Json?
  afterState    Json?
  ipAddress     String?
  userAgent     String?   @db.Text
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())

  reconJob      ReconJob? @relation(fields: [reconJobId], references: [id], onDelete: Cascade)
  reconResult   ReconResult? @relation(fields: [reconResultId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([reconResultId])
  @@index([auditType])
  @@index([createdAt(sort: Desc)])
  @@map("recon_audits")
}

model MappingTemplate {
  id                String    @id @default(uuid())
  tenantId           String?   @db.Uuid
  name               String
  description        String?
  sourceSchema       Json
  targetSchema       Json
  fieldMappings      Json      @default("{}")
  transformationRules Json     @default("[]")
  validationRules    Json      @default("[]")
  isPublic           Boolean   @default(false)
  isSystem           Boolean   @default(false)
  usageCount         Int       @default(0)
  version            Int       @default(1)
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  jobs               ReconJob[]

  @@index([tenantId])
  @@index([isPublic])
  @@map("mapping_templates")
}

model ValidationRule {
  id          String    @id @default(uuid())
  tenantId    String?   @db.Uuid
  name        String
  description String?
  ruleType    String
  ruleConfig  Json
  severity    String    @default("error")
  isActive    Boolean   @default(true)
  isPublic    Boolean   @default(false)
  isSystem    Boolean   @default(false)
  usageCount  Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([ruleType])
  @@index([isActive])
  @@index([isPublic])
  @@map("validation_rules")
}

model CustomMatchingRule {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  name              String
  description       String?
  matchConditions   Json      @default("{}") // JSON object defining matching criteria
  matchStrategy     String    @default("exact") // exact, fuzzy, regex, custom
  priority          Int       @default(0) // Lower values = higher priority
  isActive          Boolean   @default(true)
  isPublic          Boolean   @default(false)
  isSystem          Boolean   @default(false)
  applicableSources Json      @default("[]") // Array of source adapter types this rule applies to
  applicableTargets Json      @default("[]") // Array of target adapter types this rule applies to
  usageCount        Int       @default(0)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([tenantId])
  @@index([matchStrategy])
  @@index([priority])
  @@index([isActive])
  @@index([isPublic])
  @@map("custom_matching_rules")
}

model TransformRecipe {
  id                String    @id @default(uuid())
  tenantId          String?   @db.Uuid
  name              String
  description       String?
  recipeType        String
  inputSchema       Json
  outputSchema      Json
  transformationSteps Json    @default("[]")
  validationRules   Json      @default("[]")
  isPublic          Boolean   @default(false)
  isSystem          Boolean   @default(false)
  usageCount        Int       @default(0)
  version           Int       @default(1)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  jobs              ReconJob[]

  @@index([tenantId])
  @@index([recipeType])
  @@index([isPublic])
  @@map("transform_recipes")
}

model ContractVersion {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  contractName      String
  version           String
  schemaDefinition  Json
  isActive          Boolean   @default(true)
  isDeprecated      Boolean   @default(false)
  deprecatedAt      DateTime?
  breakingChanges   Json      @default("[]")
  migrationGuide    String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  driftEvents       DriftEvent[]

  @@unique([tenantId, contractName, version])
  @@index([tenantId])
  @@index([contractName])
  @@index([isActive])
  @@map("contract_versions")
}

// reconJobId is a run-scoped UUID in the console: it may reference ReconciliationRun.id
// (ingestion execution) or ReconJob.id (recon job definition). There is no single FK target,
// so integrity is enforced in application code (tenant-scoped resolution).
model DriftEvent {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
  reconJobId        String?   @db.Uuid
  contractVersionId String?   @db.Uuid
  driftType         String
  severity          String    @default("warning")
  fieldPath         String?
  expectedValue     Json?
  actualValue       Json?
  driftMetrics      Json      @default("{}")
  autoRepaired      Boolean   @default(false)
  repairAction      Json?
  acknowledged      Boolean   @default(false)
  acknowledgedBy    String?   @db.Uuid
  acknowledgedAt     DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())

  contractVersion   ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reconJobId])
  @@index([driftType])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@index([acknowledged])
  @@map("drift_events")
}

model WorkflowRun {
  id            String    @id @default(uuid())
  tenantId      String    @db.Uuid
  workflowId    String
  workflowName  String?
  workflowVersion String?
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  triggeredBy   String?
  triggerEvent  Json?
  executionGraph Json?
  stepResults   Json      @default("{}")
  errorMessage  String?   @db.Text
  errorStack    String?   @db.Text
  durationMs    BigInt?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([workflowId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("workflow_runs")
}

// ============================================================================
// ANALYTICS AND CHATBOT TABLES
// ============================================================================

// 1. Analytics Events Table
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  data      Json     @default("{}")
  userId    String?  @db.Uuid
  sessionId String?
  timestamp DateTime @default(now())
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
  @@map("analytics_events")
}

model SDKDownload {
  id             String   @id @default(cuid())
  packageName    String
  version        String
  packageManager String
  userId         String?  @db.Uuid
  sessionId      String?
  userAgent      String?
  referrer       String?
  ipAddress      String?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([packageName])
  @@index([timestamp])
  @@index([userId])
  @@map("sdk_downloads")
}

model PlaygroundUsage {
  id          String   @id @default(cuid())
  feature     String
  action      String
  integration String?
  durationMs  Int?
  success     Boolean?
  userId      String?  @db.Uuid
  sessionId   String?
  metadata    Json     @default("{}")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([feature])
  @@index([timestamp])
  @@index([userId])
  @@map("playground_usage")
}

model ChatbotConversation {
  id             String   @id @default(cuid())
  conversationId String
  message        String   @db.Text
  response       String   @db.Text
  userId         String?  @db.Uuid
  sessionId      String?
  deviceInfo     Json     @default("{}")
  metadata       Json     @default("{}")
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([timestamp])
  @@index([userId])
  @@map("chatbot_conversations")
}

model ChatbotAnalytics {
  id        String   @id @default(cuid())
  type      String
  data      Json     @default("{}")
  sessionId String?
  userId    String?  @db.Uuid
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@index([sessionId])
  @@map("chatbot_analytics")
}

model NewsletterSubscription {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  source          String?
  tags            String[]
  resendContactId String?
  subscribed      Boolean   @default(true)
  unsubscribedAt  DateTime?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([subscribed])
  @@map("newsletter_subscriptions")
}

model TenantBranding {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid @unique
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String    @default("#2563eb")
  secondaryColor    String    @default("#7c3aed")
  accentColor       String    @default("#06b6d4")
  backgroundColor   String    @default("#ffffff")
  borderRadiusScale Decimal?  @db.Decimal(3, 2)
  fontFamilyPrimary String?
  fontFamilySecondary String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_branding")
}

model TenantNavigation {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid @unique
  navItems          Json      @default("[]")
  footerItems       Json      @default("[]")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_navigation")
}

model TenantPage {
  id                String    @id @default(uuid())
  tenantId          String    @db.Uuid
