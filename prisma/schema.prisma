  userId            String?   @db.Uuid
  meta              Json      @default("{}")
  createdAt         DateTime  @default(now())

  experiment        Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([variantKey])
  @@index([tenantId])
  @@index([pageId])
  @@index([eventType])
  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
