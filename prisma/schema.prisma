  // Input changes
  inputChanged      Boolean   @default(false) @map("input_changed")
  inputDelta       Json      @default("{}")  @map("input_delta") // Summary of input changes
  sourceDataChanged Boolean   @default(false) @map("source_data_changed")
  targetDataChanged Boolean   @default(false) @map("target_data_changed")
  
  // Count changes
  totalDelta        Int       @default(0) @map("total_delta")
  matchedDelta      Int       @default(0) @map("matched_delta")
  unmatchedDelta    Int       @default(0) @map("unmatched_delta")
  exceptionDelta     Int       @default(0) @map("exception_delta")
  
  // Severity changes
  criticalDelta     Int       @default(0) @map("critical_delta")
  highDelta         Int       @default(0) @map("high_delta")
  mediumDelta       Int       @default(0) @map("medium_delta")
  lowDelta         Int       @default(0) @map("low_delta")
  
  // New patterns
  newExceptionPatterns Json   @default("[]")  @map("new_exception_patterns") // Exception archetypes that appeared for first time
  resolvedPatterns    Json    @default("[]")  @map("resolved_patterns") // Patterns that resolved
  
  // Drift detection
  configDriftDetected Boolean @default(false) @map("config_drift_detected")
  configDriftSummary  Json    @default("[]") @map("config_drift_summary")
  
  // Quality signals
  confidenceDelta    Decimal?  @db.Decimal(5, 4) @map("confidence_delta")
  qualityScoreDelta  Decimal?  @db.Decimal(5, 4) @map("quality_score_delta")
  
  // Analysis metadata
  analysisVersion    Int      @default(1) @map("analysis_version")
  algorithm          String   @default("v1")
  processingTimeMs  BigInt? @map("processing_time_ms")
  
  metadata           Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workerRuns        WorkerRun[]

  @@unique([currentRunId])
  @@index([tenantId])
  @@index([jobId])
  @@index([previousRunId])
  @@index([createdAt(sort: Desc)])
  @@map("run_deltas")
}

// Bounded workforce runs: audited, deterministic worker outputs tied to canonical truth (e.g. RunDelta)
model WorkerRun {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid @map("tenant_id")
  workerKey         String     @map("worker_key") // e.g. prior_run_delta_analyst
  workerVersion     String    @default("1") @map("worker_version")
  trigger           String    @default("run_delta_computed") // run_delta_computed | api_refresh

  runDeltaId        String    @db.Uuid @map("run_delta_id")
  runDelta          RunDelta    @relation(fields: [runDeltaId], references: [id], onDelete: Cascade)

  status            String    // succeeded | failed | insufficient_data
  output            Json      @default("{}")
  evidence          Json      @default("[]")
  degradedReasons   Json      @default("[]") @map("degraded_reasons")
  errorMessage      String?   @db.Text @map("error_message")

  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime  @default(now()) @map("completed_at")

  @@index([tenantId, workerKey, createdAt(sort: Desc)])
  @@index([runDeltaId])
  @@map("worker_runs")
}

