#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

resolve_pnpm_package_file() {
  package_name="$1"
  package_suffix="$2"

  for candidate in node_modules/.pnpm/*/node_modules/"$package_name"/"$package_suffix"; do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

run_optional_node_tool() {
  entry_file="$1"
  shift

  if [ -n "$entry_file" ] && [ -f "$entry_file" ]; then
    node "$entry_file" "$@"
    return $?
  fi

  return 127
}

# Keep pre-commit low-memory and staged-aware.
# Full verification remains in pre-push/CI.

# Verify migrations before commit
if git diff --cached --name-only | grep -q "supabase/migrations/"; then
  echo "🔍 Migration files detected, running verification..."
  bash scripts/verify-migrations.sh || {
    echo "❌ Migration verification failed. Please fix errors before committing."
    exit 1
  }
fi

# Generate types if schema changed
if git diff --cached --name-only | grep -q "prisma/schema.prisma"; then
  echo "🔍 Prisma schema changed, generating client..."
  if ! pnpm prisma:generate; then
    prisma_entry="$(resolve_pnpm_package_file prisma build/index.js)"

    if ! PRISMA_CLIENT_ENGINE_TYPE=wasm PRISMA_ENGINES_MIRROR= run_optional_node_tool "$prisma_entry" generate; then
      if ! npx prisma generate; then
        echo "⚠️  Skipping Prisma client generation in pre-commit."
        echo "⚠️  This Git hook is running in an environment that cannot execute the installed Prisma CLI."
        echo "💡 Run 'pnpm prisma:generate' from your working Node environment after commit if needed."
      fi
    fi
  fi
  git add src/types/ 2>/dev/null || true
fi

# Block unresolved merge conflict markers
pnpm verify:conflict-markers || {
  echo "❌ Unresolved merge conflict markers detected. Please resolve them before committing."
  exit 1
}

# Stage-scoped lint/format, sequential to reduce memory spikes on constrained machines.
echo "🔍 Running lint-staged (sequential, low-memory mode)..."
if ! pnpm exec lint-staged --concurrent false; then
  # Git for Windows can fail to execute pnpm's shimmed binary on symlink-heavy installs.
  lint_staged_entry="$(resolve_pnpm_package_file lint-staged bin/lint-staged.js)"

  if ! run_optional_node_tool "$lint_staged_entry" --concurrent false; then
    echo "⚠️  Skipping lint-staged in pre-commit."
    echo "⚠️  This Git hook runtime cannot execute the installed lint-staged package."
    echo "💡 Run 'pnpm exec lint-staged --concurrent false' from your working Node environment if you want the same checks locally."
  fi
fi

# Package-scoped quick reliability checks only (lint + config safety), no full typecheck/test here.
if ! node scripts/verify-staged-packages.mjs --tier=precommit; then
  echo "⚠️  Skipping staged package verification in pre-commit."
  echo "⚠️  This Git hook runtime could not execute Node-based verification reliably."
  echo "💡 Run 'pnpm run verify:fast' from your working Node environment before push."
fi
