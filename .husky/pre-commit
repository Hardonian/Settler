#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

resolve_pnpm_package_file() {
  package_name="$1"
  package_suffix="$2"

  for candidate in node_modules/.pnpm/*/node_modules/"$package_name"/"$package_suffix"; do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

run_optional_node_tool() {
  entry_file="$1"
  shift

  if [ -n "$entry_file" ] && [ -f "$entry_file" ]; then
    node "$entry_file" "$@"
    return $?
  fi

  return 127
}

# Keep pre-commit FAST and NON-BLOCKING (format, lint-staged only).
# Blocking checks (typecheck, test, verify) run in pre-push and CI.

# Verify migrations before commit (fast check)
if git diff --cached --name-only | grep -q "supabase/migrations/"; then
  echo "🔍 Migration files detected, running verification..."
  bash scripts/verify-migrations.sh || {
    echo "❌ Migration verification failed. Please fix errors before committing."
    exit 1
  }
fi

# Generate types if schema changed
if git diff --cached --name-only | grep -q "prisma/schema.prisma"; then
  echo "🔍 Prisma schema changed, generating client..."
  if ! pnpm prisma:generate; then
    prisma_entry="$(resolve_pnpm_package_file prisma build/index.js)"

    if ! PRISMA_CLIENT_ENGINE_TYPE=wasm PRISMA_ENGINES_MIRROR= run_optional_node_tool "$prisma_entry" generate; then
      if ! npx prisma generate; then
        echo "❌ Prisma client generation failed. Run 'pnpm prisma:generate' manually."
        exit 1
      fi
    fi
  fi
  git add src/types/ 2>/dev/null || true
fi

# Block unresolved merge conflict markers (hard fail)
if command -v pnpm >/dev/null 2>&1; then
  pnpm verify:conflict-markers || {
    echo "❌ Unresolved merge conflict markers detected. Please resolve them before committing."
    exit 1
  }
else
  echo "❌ pnpm not found. Conflict-marker gate cannot run. Install pnpm and retry."
  exit 1
fi

# Stage-scoped lint/format (blocking)
echo "🔍 Running lint-staged (sequential, low-memory mode)..."
if ! pnpm exec lint-staged --concurrent false; then
  lint_staged_entry="$(resolve_pnpm_package_file lint-staged bin/lint-staged.js)"

  if ! run_optional_node_tool "$lint_staged_entry" --concurrent false; then
    echo "❌ lint-staged failed. Run 'pnpm exec lint-staged --concurrent false' locally and fix issues."
    exit 1
  fi
fi

# Package-scoped quick config safety check (blocking)
if ! node scripts/verify-staged-packages.mjs --tier=precommit; then
  echo "❌ Staged package verification failed. Run 'pnpm run verify:fast' locally."
  exit 1
fi