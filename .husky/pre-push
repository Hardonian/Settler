#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Checking for unresolved merge conflicts..."
if command -v pnpm >/dev/null 2>&1; then
  pnpm verify:conflict-markers || {
    echo "❌ Unresolved merge conflict markers detected. Please resolve them before pushing."
    exit 1
  }
else
  echo "❌ pnpm not found. Conflict-marker gate cannot run. Install pnpm and retry."
  exit 1
fi

echo "🔍 Running pre-push verification gate (aligned with CI verify:fast)..."
if command -v pnpm >/dev/null 2>&1; then
  pnpm verify:fast || {
    echo "❌ Pre-push verification failed. Run 'pnpm run verify:fast' locally and fix issues before pushing."
    exit 1
  }
else
  echo "❌ pnpm not found. Pre-push verification cannot run. Install pnpm and retry."
  exit 1
fi