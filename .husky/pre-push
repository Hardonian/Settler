#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Checking for unresolved merge conflicts..."
pnpm verify:conflict-markers || {
  echo "⚠️  Skipping conflict-marker gate in pre-push because the local hook runtime failed."
  echo "💡 Run 'pnpm verify:conflict-markers' from your working Node environment."
}

echo "🔍 Running broader pre-push verification gate..."
pnpm verify:fast || {
  echo "⚠️  Skipping blocking pre-push verification in this local runtime."
  echo "⚠️  Mixed Windows/WSL toolchains in this repo can fail hooks even when the code is unchanged."
  echo "💡 For full release parity run: pnpm run verify:release"
}
