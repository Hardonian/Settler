{
  "jobs": [
    {
      "name": "settler-marketing-daily",
      "schedule": "0 6 * * *",
      "command": "cd /root/.openclaw/workspace/Settler/marketing && node orchestrator.js",
      "description": "Daily marketing automation run with approval workflow",
      "enabled": true
    },
    {
      "name": "settler-marketing-process-scheduled",
      "schedule": "*/15 * * * *",
      "command": "cd /root/.openclaw/workspace/Settler/marketing && node integrations/social-publisher.js process",
      "description": "Process scheduled social media posts every 15 minutes",
      "enabled": true
    },
    {
      "name": "settler-marketing-community-monitor",
      "schedule": "0 */4 * * *",
      "command": "cd /root/.openclaw/workspace/Settler/marketing && node lead-gen/community-miner.js --platform=all",
      "description": "Monitor communities for engagement opportunities",
      "enabled": true
    },
    {
      "name": "settler-marketing-competitor-monitor",
      "schedule": "0 9 * * *",
      "command": "cd /root/.openclaw/workspace/Settler/marketing && node intelligence/competitor-monitor.js",
      "description": "Daily competitor intelligence check",
      "enabled": true
    }
  ]
}
