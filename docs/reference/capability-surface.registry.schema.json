{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://settler.dev/schemas/capability-surface.registry.schema.json",
  "type": "object",
  "required": ["version", "capabilities", "workflows", "canonicalCommands", "terminology"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "generatedFrom": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "evidence",
          "cli",
          "ui",
          "api",
          "docs",
          "visibility",
          "gating",
          "maturity"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "cli": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "ui": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "api": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "docs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "visibility": { "type": "string", "minLength": 1 },
          "gating": { "type": "string", "minLength": 1 },
          "maturity": { "type": "string", "enum": ["mature", "partial", "experimental"] }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "canonicalCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "terminology": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
