# Database
DATABASE_URL=postgresql://user:password@localhost:5432/settler
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Stripe (REQUIRED - Add to GitHub Secrets)
STRIPE_SECRET_KEY=sk_test_... # or sk_live_... for production
STRIPE_WEBHOOK_SECRET=whsec_... # Get from Stripe Dashboard

# Stripe Product IDs (Auto-generated by setup-stripe-products.ts)
# Add these after running the setup script
STRIPE_PRODUCT_BASE_PLAN=prod_...
STRIPE_PRICE_BASE_PLAN=price_...
STRIPE_PRODUCT_ADDON_TIKTOK=prod_...
STRIPE_PRODUCT_ADDON_WIX=prod_...
STRIPE_PRODUCT_ADDON_GA4=prod_...
STRIPE_PRODUCT_ADDON_PAYPAL_PAYOUTS=prod_...
STRIPE_PRODUCT_ADDON_WHATSAPP_TELEGRAM=prod_...

# Redis (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application
NODE_ENV=production
PORT=3000

# Sentry (optional)
SENTRY_DSN=

# Email (optional)
RESEND_API_KEY=
